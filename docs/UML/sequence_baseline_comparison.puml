@startuml sequence_baseline_comparison
!theme plain

title Baseline Comparison Workflow

actor User
participant "ComparisonRunner" as Runner
participant "EATrainer" as EA
participant "MADDPGTrainer" as MADDPG
participant "UnifiedEvaluator" as Evaluator
database "Results" as Results

User -> Runner: compare_baselines(config)
activate Runner

note right of Runner
  config specifies:
  - algorithms: ['ea', 'maddpg']
  - budget_mode: ENV_STEPS
  - budget_value: 100000
  - num_seeds: 3
  - eval_episodes: 100
end note

== Training Phase ==

loop for each algorithm in config.algorithms
    Runner -> Runner: get_trainer(algorithm)
    
    alt algorithm == 'ea'
        Runner -> EA: train(training_config)
        activate EA
        
        EA -> EA: _translate_budget()
        note right: Convert env_steps\nto generations
        
        EA -> EA: create_toolbox()
        EA -> EA: initialize_population()
        
        loop for each seed
            EA -> EA: run_evolution(seed)
            EA -> EA: _wrap_genome_as_policy()
        end
        
        EA --> Runner: TrainingResult(policy, metrics)
        deactivate EA
        
    else algorithm == 'maddpg'
        Runner -> MADDPG: train(training_config)
        activate MADDPG
        
        MADDPG -> MADDPG: _build_cleanmarl_cmd()
        note right: Construct subprocess\ncommand with budget
        
        loop for each seed
            MADDPG -> MADDPG: _launch_subprocess(seed)
            MADDPG -> MADDPG: _monitor_training()
            note right: Parse TensorBoard\nlogs in real-time
            MADDPG -> MADDPG: _load_checkpoint()
            note right: Load trained\nactor networks
        end
        
        MADDPG --> Runner: TrainingResult(policy, metrics)
        deactivate MADDPG
    end
end

== Evaluation Phase ==

loop for each algorithm
    loop for each trained policy (seed)
        Runner -> Evaluator: evaluate(policy, env_name, eval_episodes)
        activate Evaluator
        
        loop for eval_episodes times
            Evaluator -> Evaluator: _run_episode(policy, seed)
            note right: Reset env, run to\ncompletion, collect reward
        end
        
        Evaluator -> Evaluator: _aggregate_results()
        Evaluator --> Runner: EvalResult(mean, std, min, max)
        deactivate Evaluator
    end
end

== Results Aggregation ==

Runner -> Runner: _aggregate_across_seeds()
note right
  Compute statistics:
  - Mean/std across seeds
  - Best policy per algorithm
  - Training curves comparison
end note

Runner -> Results: save_comparison_results()
activate Results
Results --> Runner: output_path
deactivate Results

Runner --> User: comparison_dict
deactivate Runner

note right of User
  Results contain:
  - Per-algorithm statistics
  - Per-seed detailed metrics
  - Training curves (EA fitness, RL rewards)
  - Best policies for each algorithm
end note

@enduml
