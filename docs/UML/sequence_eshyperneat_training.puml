@startuml sequence_eshyperneat_training
!theme plain
title ES-HyperNEAT Training Sequence (with parallel eval + recording)

actor User
participant "ESHyperNEATTrainer" as Trainer
participant "ExperimentLogger" as EL
participant "FrameRecorder" as FR
participant "UnifiedEvaluator" as UE
participant "_RecordingReporter" as RR
participant "neat.Population" as Pop
participant "ProcessPoolExecutor\n(parallel)" as Executor
participant "PettingZooWrapper" as Env
participant "ESHyperNeatPolicy" as Policy
participant "ESNetwork" as ESN
participant "Substrate" as Sub

User -> Trainer: train(TrainingConfig)
activate Trainer

Trainer -> Trainer: substrate_for_env(obs_size, act_size)
Trainer -> Sub: make_uniform_substrate(n_in, n_out)
Trainer <-- Sub: substrate (input + output coords only)

Trainer -> Trainer: build_cppn_config(input_size=5, output_size=1)

== Recording setup (if config.recording.enabled) ==
Trainer -> EL: build_logger(config, algorithm="es-hyperneat")
Trainer -> EL: get_frame_recorder(fps, fmt, ...)
EL -> FR: FrameRecorder(run_dir/'frames', ...)
FR --> EL: recorder
Trainer -> UE: UnifiedEvaluator(max_steps=500, frame_recorder=recorder)
activate UE

Trainer -> Pop: neat.Population(cppn_config, seed)
activate Pop

Trainer -> RR: _RecordingReporter(record_fn)
Trainer -> Pop: add_reporter(recording_reporter)

== Parallel or sequential eval ==
Trainer -> Trainer: effective_workers = resolve_num_workers(\n  config.num_workers if != 1 else self._num_workers)\n  backend = config.parallel_backend if != "process" else self._parallel_backend\n  (config takes precedence over the trainer-constructor default;)
alt effective_workers > 1
    Trainer -> Trainer: get_registry_snapshot()
    Trainer -> Trainer: _NeatWorkerSpec(..., substrate_spec, es_params, max_steps,\n  registry_snapshot=snapshot)
    Trainer -> Executor: make_executor(effective_workers, backend=backend, ...)\n  note: snapshot rides on the spec; workers replay it\n  (replay_registry_snapshot_once) for Dask custom envs

    loop n_generations
        Trainer -> Pop: run(parallel_eval_function, n=1)
        loop for each genome (distributed)
            Pop -> Executor: map(_neat_worker_evaluate, [(genome, spec), ...])
            Executor -> Executor: each worker rebuilds:\n  CPPN config + PettingZooWrapper\n  + Substrate + ESNetwork + ESHyperNeatPolicy
            Executor --> Pop: [(genome_id, fitness), ...]
        end
        Pop -> Trainer: on_generation(best_fitness, gen_steps)\n  (Keeps final_generation/fitness_history\n  advancing on the parallel path)
        Trainer -> Trainer: self._generation_num += 1\n  self._fitness_history.append(best_fitness)
        Pop -> Pop: reproduce / speciate
    end
    Trainer -> Executor: executor.__exit__()
else effective_workers == 1 (sequential)
    loop n_generations
        Trainer -> Pop: run(eval_function, n=1)

        loop for each genome
            Pop -> Trainer: eval_function(genomes, config)
            Trainer -> Policy: ESHyperNeatPolicy(genome, config, substrate, es_params)
            activate Policy

            Policy -> Policy: neat.nn.FeedForwardNetwork.create(genome, config)
            note right: CPPN (5 inputs, 1 output weight)
            Policy -> ESN: ESNetwork(substrate, cppn, params)
            activate ESN
            ESN -> ESN: es_hyperneat()
            note right
                Quadtree variance analysis:
                1. division_initialization from each input
                2. pruning_extraction (band-threshold)
                3. iterate from hidden nodes
                4. explore to outputs
                5. clean_net (dead-end removal)
            end note
            ESN -> ESN: create_phenotype_network()
            note right
                Map discovered hidden coords to IDs.
                Build node_evals from connections.
                Return RecurrentNetwork.
            end note
            Policy <-- ESN: phenotype RecurrentNetwork
            deactivate ESN

            Trainer -> Policy: get_action(obs)
            Policy -> Policy: _network.reset()
            loop activation_steps = 2^max_depth + 1
                Policy -> Policy: _network.activate(obs)
                note right
                    RecurrentNetwork buffer propagates
                    across hidden-node paths each tick.
                    Single-tick would miss hidden-layer
                    contributions → constant heading.
                end note
            end
            Policy -> Policy: head.decode(raw_output)
            Trainer <-- Policy: action
            deactivate Policy

            Trainer -> Env: reset / step loop
            Trainer -> Trainer: genome.fitness = mean(rewards)
        end

        Pop -> Pop: reproduce / speciate
    end
end

== Recording: champion rollout (RecordingController decides per mode) ==
alt recording enabled
    loop generation g where g > 0
        Pop -> RR: post_evaluate(config, pop, species, best_genome)
        RR -> RR: _record_fn(g, best_genome) → RecordingController.observe(ProgressEvent(g), champion)
        RR -> UE: (when due) evaluate(policy=ESHyperNeatPolicy(best_genome, ...),\n  env_name, num_episodes=1, iteration=g, env_steps)
        UE -> FR: start_episode()
        loop rollout steps
            UE -> UE: env.render('rgb_array')
            UE -> FR: add_frame(frame)
            UE -> UE: env.step(actions)
        end
        UE -> FR: end_episode()
        FR -> FR: imwrite(train_episode_{g:04d}.mp4)
    end
end

Trainer -> Policy: ESHyperNeatPolicy(best_genome, config, substrate)

Trainer -> UE: close()
Trainer -> EL: close()

Trainer --> User: TrainingResult(algorithm="ES-HyperNEAT")
deactivate Trainer

@enduml
