@startuml service_runtime
!theme plain
skinparam classAttributeIconSize 0
skinparam groupInheritance 2
skinparam dpi 300
left to right direction
skinparam wrapWidth 240

title Backend service: application, dispatcher and runner

package "deap_pettingzoo.service (v0.2+)" {
    class FastAPIApp <<FastAPI>> {
        + GET /health  ' incl. advanced_enabled
        + GET /catalog
        + POST /experiments
        + POST /experiments/validate
        + POST /env/install  ' gated
        + GET /env/install/{job_id}  ' gated
        + POST /experiments/script  ' gated, kind="script"
        + POST /experiments/script/validate  ' gated
        + GET /experiments/{id}
        + GET /experiments/{id}/progress
        + GET /experiments/{id}/stdout
        + GET /logs
        + GET /experiments/{id}/export
        + GET /experiments/{id}/spec
        + DELETE /experiments/{id}
        ' 404 unknown id; 409 if status=="running" (cancel first)
        + POST /experiments/{id}/cancel
        ' 404 unknown id; 409 if already terminal
        + POST /experiments/import
        .. one exception_handler(Exception) -> {"detail": "..."} ..
        ' A single JSON error envelope for every unhandled 500
        + GET /runs/export
        + GET /queue
        + POST /queue/pause
        + POST /queue/resume
    }
    class Dispatcher {
        - _running_proc: subprocess.Process | None
        - _running_exp_id: str | None
        - _worker_limit: int = 1
        --
        + start()  ' crash recovery: db.requeue_interrupted(), not set-failed
        + cancel(experiment_id)  ' DB decides eligibility; only\n  ' kills if _running_exp_id == experiment_id (proc-identity check —\n  ' _running_proc/_running_exp_id are set together by _run_one and never\n  ' written by cancel(), closing a kill-the-wrong-process race)
        + shutdown()
        .. _run_one branches on spec "kind" ..
        ' kind=="script": Popen([python, user_script.py], cwd=exp_dir)
        '   then synthesise _result.json (rglob manifest.json)
        ' spawn kwargs: start_new_session=True (POSIX) /
        '   CREATE_NEW_PROCESS_GROUP (Windows);
        ' proc.wait() wrapped in asyncio.wait_for(timeout);
        '   _compute_timeout_seconds(spec) derives the timeout from budget,
        '   clamped to DEAP_EXPERIMENT_TIMEOUT_{FLOOR,CEILING,PER_UNIT}_S
        '   (env values parsed defensively via _env_float — bad/blank knobs
        '   fall back to the default instead of failing every experiment)
        ' _terminate_group(proc) / _wait_or_kill(proc) — kill the whole tree
        '   (taskkill /T on Windows, os.killpg on POSIX), used by cancel/
        '   timeout/shutdown alike
    }
    class Runner <<subprocess>> {
        + run_experiment(spec_file, experiment_dir) -> int
        + ProgressWriter (callback -> _progress.json)
    }
    class db <<module>> {
        + create_tables()
        + insert_experiment(spec)
        + list_experiments(status, limit, offset)
        + dequeue_next() -> experiment | None
        ' One UPDATE ... RETURNING atomically claims
        '   queued -> running (+started_at); no separate set_running step
        + set_pid(id, pid)  ' attaches the pid once the subprocess is spawned
        + set_running / set_completed / set_failed / set_cancelled
        ' set_completed/set_failed/set_cancelled all gate on
        '   "status NOT IN (completed,failed,cancelled)" — once a row is
        '   terminal, none of them can overwrite it.
        + requeue_interrupted()
        ' Crash recovery re-queues a stale 'running'
        '   row instead of failing it;
        + restore_timestamps(id, created_at, started_at, finished_at)
        ' Import restore overwrites timestamps with archived values
        + update_progress(id, progress_json)
        + get_queue_state()
    }
}

FastAPIApp --> Dispatcher : lifespan manages
FastAPIApp --> db : async I/O
Dispatcher --> Runner : Popen subprocess

note as FragmentNote
  Fragment of the full class diagram
  (<i>class_diagram.puml</i>). Relations to
  types outside this fragment are omitted.
end note

@enduml
