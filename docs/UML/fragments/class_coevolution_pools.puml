@startuml coevolution_pools
!theme plain
skinparam classAttributeIconSize 0
skinparam groupInheritance 2
skinparam dpi 300
left to right direction
skinparam wrapWidth 240

title Opponent pools and hall-of-fame archives

package "deap_pettingzoo.baselines.coevolution" {
  interface "OpponentPool <<Protocol>>" as OpponentPool {
    +sample_opponent(rng): PolicyProtocol
    +sample_opponents(rng, k): List[PolicyProtocol]
    +snapshot_opponents(rng, k): List[OpponentSnapshot]
    +update(population_like)
    +__len__(): int
  }
  class "OpponentSnapshot <<dataclass>>" as OpponentSnapshot {
    +kind: str
    +payload: dict
    .. kinds ..
    feedforward / frozen /
    frozen_registered / qdax_flax
  }
  class PopulationPool {
    -items: Sequence
    -factory: Callable
    -sampler: Sampler
    +sample_opponent(rng)
    +update(new_population)
  }
  class ArchivePool {
    -archive: HallOfFame
    -policy_factory: Callable
    -sampler: Sampler
    +sample_opponent(rng)
    +update(hof)
  }
  class FrozenPolicyPool {
    -policies: Sequence[PolicyProtocol]
    +sample_opponent(rng)
    +update(new_policies)
  }
  class CompositePool {
    -pools: Sequence[OpponentPool]
    -weights: Sequence[float]
    +__init__(pools, weights)
    +sample_opponent(rng)
  }
  class RLPolicyPool {
    - policy: PolicyProtocol
    + update(policy)
    + sample_opponent(rng): PolicyProtocol
    + snapshot_sync(): RLPolicyPool
    + snapshot_opponents(rng, k): list[OpponentSnapshot]
  }
  class QDaxRepertoirePool {
    - repertoire
    - policy_factory: Callable
    - mode: "uniform" | "fitness"
    - temperature: float
    + sample_opponent(rng)
    + update(repertoire)
  }
  abstract class HallOfFame {
    +items: List
    +fitnesses: ndarray
    +is_empty: bool
    +{abstract} add(snapshot, fitness)
    +extend(snapshots, fitnesses)
    +clear()
  }
  class RingHallOfFame {
    -capacity: int
    +add(snapshot, fitness)
  }
  class ElitistHallOfFame {
    -capacity: int
    +add(snapshot, fitness)
  }

note bottom of OpponentPool
  Source-agnostic Protocol. Any object
  satisfying this contract (population,
  archive, frozen RL policies, future
  QDax repertoires) plugs into
  CoEvolutionTrainer without trainer
  modification.
end note
}

  RLPolicyPool ..|> OpponentPool
  QDaxRepertoirePool ..|> OpponentPool
  PopulationPool ..|> OpponentPool
  ArchivePool ..|> OpponentPool
  FrozenPolicyPool ..|> OpponentPool
  CompositePool ..|> OpponentPool
  HallOfFame <|-- RingHallOfFame
  HallOfFame <|-- ElitistHallOfFame
  ArchivePool --> HallOfFame : "reads"
  CompositePool o-- "*" OpponentPool

note as FragmentNote
  Fragment of the full class diagram
  (<i>class_diagram.puml</i>). Relations to
  types outside this fragment are omitted.
end note

@enduml
