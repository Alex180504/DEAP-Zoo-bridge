@startuml catalog
!theme plain
skinparam classAttributeIconSize 0
skinparam groupInheritance 2
skinparam dpi 300
left to right direction
skinparam wrapWidth 170

title Catalog metadata and registries

package "deap_pettingzoo.catalog (v0.2+)" {
    class ParamSpec <<dataclass>> {
        + name: str
        + type: ParamType (int|float|bool|str|enum|list)
        + default: Any
        + min: float | None
        + max: float | None
        + step: float | None
        + choices: list | None
        + unavailable_choices: tuple  ' (e.g. cuda w/o CUDA)
        + group: str
        + label: str
        + help: str
        + advanced: bool
        --
        + available_choices: tuple  ' choices minus unavailable_choices
        + coerce(value) -> Any  ' rejects a value in unavailable_choices
        + validate(value) -> list[str]
        + to_dict() -> dict
    }
    class AlgorithmSpec <<dataclass>> {
        + name: str
        + aliases: list[str]
        + family: str
        + hyperparameters: list[ParamSpec]
        + capabilities: dict
        + coevolution_optimizer: bool
        + required_extras: list[str]
        + supported_budget_modes: list[str]
        + supported_aggregations: list[str]
        --
        + {static} canonical_name(name) -> str
    }
    class EnvironmentSpec <<dataclass>> {
        + name: str
        + env_config: list[ParamSpec]
        + teams: list[TeamSpec]
        + api: str
        + continuous_default: bool
        + tags: set[str]
        + required_extras: list[str]
    }
    class TeamSpec <<dataclass>> {
        + name: str
        + agent_prefixes: list[str]
    }
    class ValidationReport <<dataclass>> {
        + ok: bool
        + errors: list[ValidationIssue]
        + warnings: list[ValidationIssue]
    }
    class Catalog <<facade>> {
        + list_algorithms() -> list[AlgorithmSpec]
        + get_algorithm(name) -> AlgorithmSpec
        + register_algorithm(name, *, trainer, side_state=None, ...) -> None
        + list_environments() -> list[EnvironmentSpec]
        + get_environment(name) -> EnvironmentSpec
        + get_coevolution_options() -> dict
        + compatible_algorithms(env, algos) -> dict
        + to_json() -> dict
    }
    class "_AlgorithmDefinition <<dataclass, frozen>>" as AlgorithmDefinition {
        + name / label / family: str
        + trainer_module / trainer_class: str  ' dotted "module:QualName"
        + capabilities: dict
        + aliases / required_modules / required_extras: tuple
        + coevolution_optimizer: str | None
        + side_state: str | None  ' dotted SideState binding
    }
    class "algorithms <<module>>" as AlgorithmsModule {
        ' Open, mutable algorithm table (insertion-ordered), seeded from the
        ' built-ins then extended by register_algorithm / entry-point plugins.
        - _REGISTRY: dict[str, _AlgorithmDefinition]
        + register_algorithm(name, *, label, family, trainer, capabilities,\n            aliases=(), coevolution_optimizer=None, side_state=None, ...) -> None
        + iter_trainer_bindings() -> list[(name, module, class)]
        - _discover_entry_point_plugins()  ' groups: deap_pettingzoo.algorithms /\n            .coevolution_sides; broken plugin -> RuntimeWarning
        - _register_builtins()  ' seed + discover (load-once)
    }
    class availability <<module>> {
        + module_available(extra_name) -> bool
    }
}

    AlgorithmsModule *-- AlgorithmDefinition
Catalog --> AlgorithmSpec : contains
Catalog --> EnvironmentSpec : contains
AlgorithmSpec --> ParamSpec : hyperparameters
EnvironmentSpec --> TeamSpec : teams

