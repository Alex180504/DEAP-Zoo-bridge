@startuml trainers_cma_pso
!theme plain
skinparam classAttributeIconSize 0
skinparam groupInheritance 2
skinparam dpi 300
skinparam wrapWidth 240

title CMA-ES and particle-swarm trainers

package "deap_pettingzoo.baselines" {
    abstract class BaselineTrainer {
        + {abstract} train(config: TrainingConfig) -> TrainingResult
        + {abstract} supports_budget_mode(mode: BudgetMode) -> bool
        + {abstract} get_capabilities() -> dict
        -- module helper: derive_generations(budget, pop, max_steps)
    }
    class CMAESTrainer {
        - hidden_size: int
        - population_size: int
        - sigma0: float
        - activation: str
        - variant: str  ' mu_mu_lambda | one_plus_lambda
        --
        + __init__(hidden_size, population_size, sigma0, activation, weight_range, variant)
        + train(config) -> TrainingResult
        + supports_budget_mode(mode) -> bool
        + get_capabilities() -> dict
        - _build_strategy(genome_config) -> (Strategy, int)
        - _translate_budget(config) -> dict
    }
    class PSOTrainer {
        - hidden_size: int
        - population_size: int
        - phi1: float  ' cognitive coefficient
        - phi2: float  ' social coefficient
        - weight: float  ' inertia weight
        - eval_episodes: int  ' CRN episodes averaged per particle/gen
        --
        + __init__(hidden_size, population_size, phi1, phi2, weight, smin, smax, activation, weight_range, eval_episodes=1)
        + train(config) -> TrainingResult
        + supports_budget_mode(mode) -> bool
        + get_capabilities() -> dict
        - _translate_budget(config) -> dict
        .. note ..
        eval_episodes>1 scores every particle on one
        shared per-gen seed set (CRN) then averages,
        de-noising fitness in stochastic envs.
        Champion saved as pso_genome_v1.
    }

note bottom of CMAESTrainer
  Wraps deap.cma.Strategy. Uses a
  custom CMAIndividual (list subclass
  with a .genome attribute) so that
  numpy.array(pop) inside strategy.update
  works while preserving evaluator
  contract.
end note
}

    BaselineTrainer <|-- CMAESTrainer
    BaselineTrainer <|-- PSOTrainer

note as FragmentNote
  Fragment of the full class diagram
  (<i>class_diagram.puml</i>). Relations to
  types outside this fragment are omitted.
end note

@enduml
