@startuml sequence_agilerl_hpo_training
!theme plain
' Compact layout (tuned per diagram — see README, 'Sequence-diagram layout').
hide footbox
skinparam maxMessageSize 180
skinparam wrapWidth 240
title AgileRL Evolvable-HPO Training Sequence

actor User
participant "EvolveHPOTrainer\n(MADDPG/MATD3/IPPO/GroupedIPPO HPO)" as Trainer
participant "agilerl.hpo" as HPO
participant "PettingZooWrapper" as Env
participant "ExperimentLogger" as Log
participant "ProbeController" as Probe
participant "AgileRLPolicyWrapper" as Policy

User -> Trainer: train(config, *, progress_callback)
activate Trainer

Trainer -> Trainer: _build_hp_config(spec)
Trainer -> HPO: HyperparameterConfig(rl_params)
activate HPO
HPO --> Trainer: hp_config
deactivate HPO

Trainer -> Trainer: _prepare_population_build(...)
note right: GroupedIPPOHPOTrainer installs the\ngrouped-IPPO patch + validates grouping.
Trainer -> Trainer: _build_population(size=N, obs/act spaces, net_config, hp_config)
note right
    Population of N AgileRL agents,
    each with a different sampled
    architecture + hyperparameter set.
end note

Trainer -> Trainer: ProbeController(config, log) + per-slot replay buffers
note right
    Off-policy: one persistent MultiAgentReplayBuffer
    per population slot (owned by the trainer, keyed
    by slot — AgileRL clone() strips underscore attrs),
    reused across generations. ProbeController is
    no-op unless config.probe.enabled.
end note

loop ep_cycle (until env-step budget)
    loop for each agent in population
        alt ON_POLICY (IPPO / grouped IPPO)
            Trainer -> Env: _train_one_agent_on_policy(...)
            note right: Shared agilerl_onpolicy.train_agent_on_policy:\ncollect rollouts -> agent.learn() (GAE)
        else off-policy (MADDPG / MATD3)
            Trainer -> Env: _train_one_agent(..., memory=slot_buffer, total_transitions)
            note right
                Replay-buffer rollout on the slot's
                **persistent** MultiAgentReplayBuffer:
                1. buffer reused across generations
                   (built once per slot, not per call)
                2. save_to_memory(obs, raw_actions, reward,
                   next_obs, done) once per transition
                   using agent-keyed dicts
                3. agent.learn(memory.sample(batch_size))
                   gated on len(buffer)>=batch_size
                   and learning_delay/learn_step cadence
                4. returns (steps, total_transitions) so the
                   trainer persists the slot's counter
            end note
        end
    end

    Trainer -> Env: evaluate each agent (eval_episodes episodes)
    Trainer -> Trainer: fitnesses = [mean(ep_rewards) for each agent]
    Trainer -> Trainer: hall-of-fame update (best-ever, size 1)
    note right
        Mirrors EATrainer's tools.HallOfFame(1):
        clone this generation's best agent (pre-mutation)
        if it beats the incumbent. Champion for the
        recorder/probe and the final policy comes from
        here, so a mutation-degraded agent never replaces
        a better one seen earlier.
    end note
    Trainer -> Log: row("metrics", {generation, env_steps, mean, max, ...})
    Trainer -> User: progress_callback(ProgressEvent)
    note right: Per-generation live UI feed.

    Trainer -> Probe: observe(event, champion)
    note right: Off-budget held-out probe when due\n(every_n_steps). Rolls the frozen champion\nand appends one probe.csv row. No-op if\nconfig.probe.enabled is false.

    Trainer -> HPO: TournamentSelection.select(population)
    activate HPO
    HPO --> Trainer: selected (elite + tournament winners)
    deactivate HPO

    Trainer -> HPO: Mutations.mutation(population)
    activate HPO
    note right
        Architecture mutations:
        - add/remove layers
        - change activation fn
        HP mutations:
        - lr_actor, batch_size
        - learn_step, gamma
    end note
    HPO --> Trainer: mutated_population
    deactivate HPO
end

Trainer -> Probe: finalize(champion) + close()
note right: Guarantees an end-of-run probe row.

Trainer -> Env: re-score hall-of-fame champion (final_eval_episodes)
Trainer -> Log: save_agilerl_agent(champion) + write_summary(...)
Trainer -> Policy: AgileRLPolicyWrapper(hall_of_fame_best, agent_ids)
note right: Champion = best-ever HOF member.
Trainer --> User: TrainingResult(algorithm="<algo>-hpo", policy=champion)
deactivate Trainer

@enduml
