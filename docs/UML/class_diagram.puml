    -_run_synchronous_loop(...): None
    -_run_alternating_loop(...): None
    -_step_one_side(env, state, states, coev_cfg, history, pool_snapshot=None): None
    -_setup_recording(config): int
    -_record_champion_if_due(...): None
    -_invoke_generation_callback(...): None
  }

  PopulationPool ..|> OpponentPool
  ArchivePool ..|> OpponentPool
  FrozenPolicyPool ..|> OpponentPool
  CompositePool ..|> OpponentPool

  HallOfFame <|-- RingHallOfFame
  HallOfFame <|-- ElitistHallOfFame

  SideState <|-- EASideState
  SideState <|-- CMAESSideState
  SideState <|-- FrozenSideState
  SideState <|-- PSOSideState
  SideState <|-- RLSideState
  SideState <|-- RLEvolveHPOSideState
