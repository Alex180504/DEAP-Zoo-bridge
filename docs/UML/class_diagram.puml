package "deap_pettingzoo.baselines" {
    enum BudgetMode {
        ENV_STEPS
        EVAL_EPISODES
        WALL_CLOCK
    }

    interface PolicyProtocol <<Protocol>> {
        + get_action(observation) -> action
        + reset() -> None
    }

    class TrainingConfig <<dataclass>> {
        + env_name: str
        + budget_mode: BudgetMode
        + budget_value: int
        + num_seeds: int
        + algorithm_params: dict
        + output_dir: Path
        + render: bool
        + recording: RecordingConfig
    }

    class RecordingConfig <<dataclass>> {
        + enabled: bool
        + every_n_generations: Optional[int]
        + fps: int
        + fmt: str
        + max_frames_per_episode: Optional[int]
        + episode_prefix: str
    }

    class TrainingResult <<dataclass>> {
        + algorithm: str
        + policy: PolicyProtocol
        + metrics: dict
        + metadata: dict
        + seed: int
        + training_time: float
    }

    class EvalResult <<dataclass>> {
        + mean_reward: float
        + std_reward: float
        + min_reward: float
        + max_reward: float
        + num_episodes: int
        + episode_rewards: List[float]
        + episode_lengths: List[int]
        + to_dict() -> dict
    }

    class ComparisonConfig <<dataclass>> {
        + algorithms: List[str]
        + env_name: str
        + budget_mode: BudgetMode
        + budget_value: int
        + num_seeds: int
        + eval_episodes: int
        + algorithm_configs: dict
        + output_dir: Path
    }

    abstract class BaselineTrainer {
        + {abstract} train(config: TrainingConfig) -> TrainingResult
        + {abstract} supports_budget_mode(mode: BudgetMode) -> bool
        + {abstract} get_capabilities() -> dict
    }

    abstract class BaselineEvaluator {
        + {abstract} evaluate(policy, env_name, num_episodes, seed, render) -> EvalResult
    }

    class GenomePolicyWrapper {
        - genome: FixedTopologyGenome
        - env_name: str
        - _policies: dict
        --
        + __init__(genome, env_name)
        + get_action(observation) -> action
        + reset() -> None
        + genome() -> FixedTopologyGenome
    }

    class EATrainer {
        - hidden_size: int
        - population_size: int
        - mutation_rate: float
        - crossover_rate: float
        - strategy: str  ' simple | mu_plus_lambda | mu_comma_lambda
        - mu: int
        - lambda_: int
        - selection_method: str
        - crossover_method: str
        - mutation_method: str
        --
        + __init__(hidden_size, population_size, ..., strategy, mu, lambda_, selection_method, crossover_method, mutation_method, selection_params, crossover_params, mutation_params)
        + train(config) -> TrainingResult
        + supports_budget_mode(mode) -> bool
        + get_capabilities() -> dict
        - _run_simple(...) -> None
        - _translate_budget(config) -> dict
    }

    class CMAESTrainer {
        - hidden_size: int
        - population_size: int
        - sigma0: float
        - activation: str
        - variant: str  ' mu_mu_lambda | one_plus_lambda
        --
        + __init__(hidden_size, population_size, sigma0, activation, weight_range, variant)
        + train(config) -> TrainingResult
        + supports_budget_mode(mode) -> bool
        + get_capabilities() -> dict
        - _build_strategy(genome_config) -> (Strategy, int)
        - _translate_budget(config) -> dict
    }

    abstract class AgileRLTrainer {
        # ALGORITHM_NAME: str
        # ALGORITHM_IMPORT: tuple[str, str]
        # ON_POLICY: bool
        # DEFAULT_PARAMS: dict
        --
        + train(config) -> TrainingResult
        + supports_budget_mode(mode) -> bool
        + {abstract} get_capabilities() -> dict
        # _import_algorithm() -> type
        # _build_agent(obs_spaces, act_spaces, agent_ids, kwargs)
        # _run_off_policy(env, agent, ...) -> dict
        # _run_on_policy(env, agent, ...) -> dict
    }

    class MADDPGTrainer {
        # ALGORITHM_NAME = "maddpg"
        # ON_POLICY = False
    }
    class MATD3Trainer {
        # ALGORITHM_NAME = "matd3"
        # ON_POLICY = False
    }
    class IPPOTrainer {
        # ALGORITHM_NAME = "ippo"
        # ON_POLICY = True
    }
    class MAPPOTrainer {
        # ALGORITHM_NAME = "mappo"
        # ON_POLICY = True
    }
    class GroupedIPPOTrainer {
        # ALGORITHM_NAME = "ippo-grouped"
        # ON_POLICY = True
        --
        + {static} _group_prefix(agent_id) -> str
        + {static} _validate_grouping(agent_ids, obs, act) -> dict
    }

    class AgileRLPolicyWrapper {
        - _agent: agilerl.EvolvableAlgorithm
        - _agent_ids: list[str]
        - _call_index: int
        --
        + get_action(obs) -> Any
        + reset() -> None
    }

    class UnifiedEvaluator {
        - max_steps: int
        - env_cache: dict
        --
        + __init__(max_steps)
        + evaluate(policy, env_name, num_episodes, seed, render) -> EvalResult
        - _run_episode(policy, env, seed) -> tuple
        + close()
    }

    class "comparison (module)" as comparison_mod <<module>> {
        - _TRAINER_REGISTRY: dict[str, type]
        --
        + register_trainer(name, trainer_class) -> None
        + get_trainer(name, **kwargs) -> BaselineTrainer
        + compare_baselines(config: ComparisonConfig) -> dict
        - _register_builtins() -> None
    }

    ' Relationships
    TrainingConfig --> BudgetMode : uses
    TrainingConfig *-- RecordingConfig : recording
    ComparisonConfig --> BudgetMode : uses
    TrainingResult --> PolicyProtocol : contains

    BaselineTrainer <|-- EATrainer
    BaselineTrainer <|-- CMAESTrainer
    BaselineTrainer <|-- AgileRLTrainer
    AgileRLTrainer <|-- MADDPGTrainer
    AgileRLTrainer <|-- MATD3Trainer
    AgileRLTrainer <|-- IPPOTrainer
    IPPOTrainer <|-- MAPPOTrainer
    IPPOTrainer <|-- GroupedIPPOTrainer
    BaselineEvaluator <|-- UnifiedEvaluator

    EATrainer ..> deap_integration_mod : uses
    EATrainer ..> GenomePolicyWrapper : produces
    CMAESTrainer ..> cma_integration_mod : uses
    CMAESTrainer ..> GenomePolicyWrapper : produces
    GenomePolicyWrapper --> FixedTopologyGenome : wraps
    GenomePolicyWrapper ..|> PolicyProtocol : implements

    AgileRLTrainer --> AgileRLPolicyWrapper : produces
    AgileRLPolicyWrapper ..|> PolicyProtocol : implements

    comparison_mod ..> BaselineTrainer : registry
    comparison_mod --> UnifiedEvaluator : uses
    comparison_mod --> ComparisonConfig : consumes

    FeedforwardNeuralPolicy ..|> PolicyProtocol : implements
    APFEvaderPolicy ..|> PolicyProtocol : implements
}

' Cross-package interaction notes
SingleEpisodeEvaluator ..> FixedTopologyGenome : evaluates
MixedPolicyEvaluator ..> PolicyProtocol : runs

note bottom of FixedTopologyGenome
  Genome is a flat vector of weights
  for a fixed MLP architecture.
end note

note bottom of CMAESTrainer
  Wraps deap.cma.Strategy. Uses a
  custom CMAIndividual (list subclass
  with a .genome attribute) so that
  numpy.array(pop) inside strategy.update
  works while preserving evaluator
  contract.
end note

note bottom of GenomePolicyWrapper
  Shared adapter used by both EATrainer
  and CMAESTrainer to expose a trained
  genome as a PolicyProtocol for
  UnifiedEvaluator.
end note

note bottom of MixedPolicyEvaluator
  Two construction paths:
  * Live-object path (env_wrapper=...) —
    backward-compatible; not picklable.
  * Factory path (env_factory=...,
    scripted_policy_factory=...) —
    required for parallel evaluation;
    factories must be module-level callables.
  Use make_mixed_parallel_evaluate_map
  to integrate with DEAP toolbox.map.
end note

note bottom of SelfPlayEvaluator
  Canonical EA evaluator for
  strictly turn-based AEC games
  (api='aec_masked' / 'aec_sequential').
  Installs a MaskedDiscreteHead so
  infos[agent]["action_mask"] is honoured.
end note

note bottom of registry
  EnvSpec.wrappers is an ordered chain
  of plain (env -> env) callables applied
  after api coercion. Typical use is
  composing supersuit transforms
  (pad_observations_v0, pad_action_space_v0,
  agent_indicator_v0, ...).
end note

note bottom of openspiel
  Opt-in; nothing registered on import.
  Requires `pip install deap-pettingzoo[shimmy]`.
  Wraps shimmy.OpenSpielCompatibilityV0
  for OpenSpiel turn-based games.
end note

package "deap_pettingzoo.contrib.qdax" {
    class FlaxPolicyAdapter {
        - module
        - params
        - masked: bool
        + get_action(obs, action_mask=None) -> Any
    }

    class "descriptors <<module>>" as qdax_descriptors {
        + formation_spread_and_mean_distance(num_pursuers, num_evaders)
        + with_capture_efficiency(num_pursuers, num_evaders, capture_radius)
        -- each returns a callable with\n   output_shape / min_bd / max_bd --
    }

    class "scoring <<module>>" as qdax_scoring {
        + make_jax_scoring_function(jax_env, module, *, episode_length,\n         descriptor_fn, action_type, agents=None,\n         extract_state_fn=None) -> Callable
        + make_numpy_scoring_function(env_name, *, layer_sizes,\n         episode_length, descriptor_fn, env_config=None,\n         action_type="discrete", activation="tanh",\n         num_workers=1, parallel_backend="process") -> Callable
        -- both return QDax contract:\n   (genotypes, key) -> (fitness, descriptor, extra_scores) --
    }

    class MAPElitesTrainer {
        + algorithm = "map_elites"
        + train(config): TrainingResult
        -- dispatches to jax scoring\n   when env.api == "jax_parallel",\n   numpy fallback otherwise --
    }

    class CMAMETrainer {
        + algorithm = "cma_me"
        + train(config): TrainingResult
        -- CMAImprovementEmitter +\n   CMAPoolEmitter over a\n   euclidean/CVT centroid grid --
    }

    FlaxPolicyAdapter ..|> PolicyProtocol : implements
    MAPElitesTrainer --|> BaselineTrainer
    CMAMETrainer     --|> BaselineTrainer
    MAPElitesTrainer ..> qdax_scoring : uses
    CMAMETrainer     ..> qdax_scoring : uses
    MAPElitesTrainer ..> qdax_descriptors : resolves by name
    CMAMETrainer     ..> qdax_descriptors : resolves by name
    MAPElitesTrainer ..> FlaxPolicyAdapter : produces best
    CMAMETrainer     ..> FlaxPolicyAdapter : produces best
}

note bottom of MAPElitesTrainer
  Opt-in; requires `pip install deap-pettingzoo[qdax]`.
  Takes fast jit+vmap path only when the
  env is registered with api="jax_parallel";
  otherwise rolls out through a numpy boundary
  and warns the user.
end note

package "deap_pettingzoo.baselines.coevolution" {

  interface "OpponentPool <<Protocol>>" as OpponentPool {
    +sample_opponent(rng): PolicyProtocol
    +sample_opponents(rng, k): List[PolicyProtocol]
    +snapshot_opponents(rng, k): List[OpponentSnapshot]
    +update(population_like)
    +__len__(): int
  }

  class "OpponentSnapshot <<dataclass>>" as OpponentSnapshot {
    +kind: str
    +payload: dict
    .. kinds ..
    feedforward / frozen /
    frozen_registered / qdax_flax
  }

  class PopulationPool {
    -items: Sequence
    -factory: Callable
    -sampler: Sampler
    +sample_opponent(rng)
    +update(new_population)
  }

  class ArchivePool {
    -archive: HallOfFame
    -policy_factory: Callable
    -sampler: Sampler
    +sample_opponent(rng)
    +update(hof)
  }

  class FrozenPolicyPool {
    -policies: Sequence[PolicyProtocol]
    +sample_opponent(rng)
    +update(new_policies)
  }

  class CompositePool {
    -pools: Sequence[OpponentPool]
    -weights: Sequence[float]
    +__init__(pools, weights)
    +sample_opponent(rng)
  }

  abstract class HallOfFame {
    +items: List
    +fitnesses: ndarray
    +is_empty: bool
    +{abstract} add(snapshot, fitness)
    +extend(snapshots, fitnesses)
    +clear()
  }

  class RingHallOfFame {
    -capacity: int
    +add(snapshot, fitness)
  }

  class ElitistHallOfFame {
    -capacity: int
    +add(snapshot, fitness)
  }

  class "Side <<dataclass>>" as Side {
    +name: str
    +role_prefixes: Tuple[str, ...]
    +optimizer: str
    +optimizer_config: dict
    +hof: Optional[HallOfFame]
    +use_archive_in_opponent_pool: bool
    +archive_mix: float
    +opponent_sampler: Sampler
    +archive_sampler: Sampler
    +frozen_policies: Optional[Sequence]
  }

  abstract class SideState {
    +side: Side
    +{abstract} initialise(env, evaluator, rng)
    +{abstract} step_generation(evaluator, rng)
    +{abstract} current_pool(): OpponentPool
    +{abstract} best_policy(): PolicyProtocol
    +snapshot_best()
  }

  class EASideState
  class CMAESSideState
  class FrozenSideState

  class RLPolicyPool {
    - policy: PolicyProtocol
    + update(policy)
    + sample_opponent(rng): PolicyProtocol
    + snapshot_sync(): RLPolicyPool
    + snapshot_opponents(rng, k): "raises NotImplementedError"
  }

  class RLSideState {
    -- one AgileRL algorithm object per side\n   (no population). Generation =\n   rollout_episodes_per_gen rollouts +\n   learning_steps_per_gen learn() calls.\n   v1: MADDPG / MATD3 only.
    +algorithm: str
    +is_on_policy: bool
    +rollout_episodes_per_gen: int
    +learning_steps_per_gen: int
    +resolved_device: str
    + current_pool(): RLPolicyPool
    + best_policy(): AgileRLPolicyWrapper
  }

  RLPolicyPool ..|> OpponentPool
  RLSideState  --|> SideState

  class QDaxRepertoirePool {
    - repertoire
    - policy_factory: Callable
    - mode: "uniform" | "fitness"
    - temperature: float
    + sample_opponent(rng)
    + update(repertoire)
  }

  class QDaxSideState {
    -- runs one QDax iteration\n   per co-evolution generation.\n   Experimental: placeholder descriptor.
    + current_pool(): QDaxRepertoirePool
    + best_policy(): FlaxPolicyAdapter
  }

  QDaxRepertoirePool ..|> OpponentPool
  QDaxSideState      --|> SideState

  class "CoEvolutionConfig <<dataclass>>" as CoEvolutionConfig {
    +mode: str
    +sides: List[Side]
    +schedule: str
    +alternating_generations: int
    +k_opponents: int
    +aggregation: str
    +snapshot_every: int
    +reporting_side: Optional[str]
    +max_steps_per_episode: int
    +seed: Optional[int]
    +num_workers: int = 1
    +parallel_backend: str = "process"
  }

  class CoEvolutionEvaluator {
    -env_wrapper: PettingZooWrapper
    -learner_role_prefixes: Tuple[str, ...]
    -learner_factory: Callable
    -opponent_sides: List[(name, prefixes, pool)]
    -k_opponents: int
    -aggregation: str
    -max_steps: int
    +__init__(env_wrapper, learner_role_prefixes, learner_factory,\n  opponent_sides, k_opponents, aggregation,\n  max_steps, flatten_obs, masked)
    +evaluate(individual, seed, rng)
  }

  class CoEvolutionTrainer {
    +train(config): TrainingResult
  }

  PopulationPool ..|> OpponentPool
  ArchivePool ..|> OpponentPool
  FrozenPolicyPool ..|> OpponentPool
  CompositePool ..|> OpponentPool

  HallOfFame <|-- RingHallOfFame
  HallOfFame <|-- ElitistHallOfFame

  SideState <|-- EASideState
  SideState <|-- CMAESSideState
  SideState <|-- FrozenSideState

  SideState o-- Side
  Side o-- HallOfFame

  ArchivePool --> HallOfFame : "reads"
  CompositePool o-- "*" OpponentPool

  CoEvolutionConfig *-- "1..*" Side
  CoEvolutionTrainer ..> CoEvolutionConfig : consumes
  CoEvolutionTrainer ..> SideState : "builds per side"
  CoEvolutionTrainer ..> CoEvolutionEvaluator : uses
  CoEvolutionEvaluator ..> OpponentPool : "samples one per side"
}

note bottom of OpponentPool
  Source-agnostic Protocol. Any object
  satisfying this contract (population,
  archive, frozen RL policies, future
  QDax repertoires) plugs into
  CoEvolutionTrainer without trainer
  modification.
end note

note bottom of CoEvolutionTrainer
  Registered as "coevolution". Three modes:
  competitive_2pop, self_play_hof, cooperative.
  Schedule: synchronous | alternating.
  Reports reporting_side's best policy.
end note

' ---------------- experiment logging ----------------

package "deap_pettingzoo.utils.logging" {

  class "RunManifest <<dataclass>>" as RunManifest {
    +schema_version: int
    +run_id: str
    +algorithm: str
    +env_name: str
    +env_config: dict
    +seed: Optional[int]
    +budget_mode: Optional[str]
    +budget_value: Any
    +hyperparams: dict
    +notes: str
    +created_at: str
    +wall_time_s: Optional[float]
    +artifacts: dict[str, str]
    +environment: dict
    +write(path: Path)
  }

  interface Sink <<Protocol>> {
    +open(run_dir: Path)
    +log_row(table: str, row: Mapping)
    +log_scalar(name: str, value: float, step: int)
    +flush()
    +close()
  }

  class NoOpSink
  class JsonManifestSink {
    -tables: tuple[str, ...]
    +DEFAULT_TABLES = ("summary",)
  }
  class CsvScalarSink {
    -writers: dict[str, DictWriter]
    -headers: dict[str, list[str]]
  }
  class ParquetTrajectorySink
  class TensorBoardSink
  class MultiSink {
    -sinks: list[Sink]
  }

  class ExperimentLogger {
    +run_dir: Path
    +manifest: RunManifest
    -sink: Sink
    +{static} create(output_dir, *, algorithm, env_name, seed, ...)
    +{static} from_config(config, *, algorithm, notes)
    +row(table, row)
    +scalar(name, value, step)
    +add_artifact(name, path)
    +close()
    +__enter__() / __exit__()
  }

  class NoOpLogger {
    +run_dir = Path()
    +manifest.run_id = "noop"
  }

  class FrameRecorder {
    -run_dir: Path
    -fps: int
    -fmt: str
    -max_frames_per_episode: Optional[int]
    -episode_prefix: str
    +start_episode(idx)
    +add_frame(rgb)
    +end_episode(): Optional[Path]
  }

  class capture_environment_metadata <<function>>
}

ExperimentLogger o-- RunManifest
ExperimentLogger o-- Sink
NoOpLogger ..|> ExperimentLogger
MultiSink o-- "*" Sink
NoOpSink         ..|> Sink
JsonManifestSink ..|> Sink
CsvScalarSink    ..|> Sink
ParquetTrajectorySink ..|> Sink
TensorBoardSink  ..|> Sink
MultiSink        ..|> Sink
RunManifest ..> capture_environment_metadata : "fills .environment"

note bottom of ExperimentLogger
  All baseline trainers use
  baselines._logging_helpers.build_logger()
  → ExperimentLogger.from_config().
  When config.output_dir is None →
  NoOpLogger (zero disk I/O).
  Backend has no functional dependency
  on artefacts; the analysis & UI
  layers consume them read-only.
end note

' ---------------- offline analysis ----------------

package "deap_pettingzoo.analysis" {

  class "RunRecord <<dataclass>>" as RunRecord {
    +run_dir: Path
    +manifest: dict
    +metrics: pd.DataFrame
    +episodes: pd.DataFrame
    +trajectories: pd.DataFrame
    +summary: dict
    +algorithm: str
    +env_name: str
    +seed: Optional[int]
    +run_id: str
    +wall_time_s: Optional[float]
    +final_fitness: Optional[float]
  }

  class Experiment {
    +root: Path
    +runs: list[RunRecord]
    +filter(*, algorithm, env, seed): Experiment
    +by_algorithm(): dict[str, list[RunRecord]]
    +by_env(): dict[str, list[RunRecord]]
    +summary_table(): pd.DataFrame
    +final_scores(metric): dict[str, ndarray]
  }

  class loaders <<module>> {
    +load_run(run_dir): RunRecord
    +load_experiment(root, pattern): Experiment
  }

  class aggregate <<module>> {
    +iqm(scores): float
    +bootstrap_ci(scores, *, statistic, n_resamples, ci, seed)
    +mean_with_ci(scores, **kw)
    +iqm_with_ci(scores, **kw)
    +learning_curve_with_ci(runs, *, x_col, y_col, statistic)
    +aggregate_summary(score_groups): pd.DataFrame
  }

  class compare <<module>> {
    +cohens_d(a, b): float
    +cliffs_delta(a, b): float
    +mann_whitney(a, b, alternative)
    +welch_t(a, b, alternative)
    +pairwise_table(experiment, *, metric, test): pd.DataFrame
  }

  class rliable_bridge <<module>> {
    +aggregate_metrics_table(score_groups, *, reps)
    +performance_profile(score_groups, *, taus, reps)
    +probability_of_improvement(score_groups, *, reps)
    +sample_efficiency_curve(runs_by_algo, *, x_col, y_col, x_grid, reps)
  }

  class plots <<module>> {
    +plot_learning_curves(runs_by_algo, ...)
    +plot_eval_distribution(score_groups, ...)
    +plot_performance_profile(score_groups, *, taus, ...)
    +plot_pi_matrix(score_groups, ...)
  }

  class report <<module>> {
    +build_report(experiment, output_dir, *, metric, fmt, include_figures, title): Path
  }
}

Experiment "1" *-- "*" RunRecord
loaders ..> Experiment : returns
loaders ..> RunRecord : returns
aggregate ..> RunRecord : reads .metrics
compare ..> Experiment : reads .final_scores()
rliable_bridge ..> Experiment : "score_groups input"
plots ..> aggregate
report ..> aggregate
report ..> compare
report ..> plots

RunRecord ..> RunManifest : "loads manifest.json"

note bottom of rliable_bridge
  Lazy-imports rliable; raises
  ImportError("install with .[analysis]")
  if missing. iqm() in aggregate matches
  rliable.metrics.aggregate_iqm to 1e-9.
end note

note bottom of report
  Renders Markdown or HTML via jinja2
  with summary_table, aggregate_summary,
  pairwise_table, plus optional
  fig_eval_distribution.png and
  fig_learning_curves.png. The
  forthcoming Streamlit UI consumes the
  same surfaces — no new public API.
end note

