@startuml class_diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam groupInheritance 2

title DEAP-PettingZoo Bridge - Class Diagram

package "deap_pettingzoo.genomes" {
    class FixedTopologyGenome {
        + layer_sizes: List[int]
        + activation: str
        + input_size: int
        + output_size: int
        + hidden_layers: List[int]
        + weight_range: tuple[float, float]
        --
        + __init__(layer_sizes, activation, weight_range: tuple[float, float], random_seed)
        + get_weight_count() -> int
        + get_weight_ranges() -> List[tuple]
        + get_weights() -> np.ndarray
        + set_weights(weights: np.ndarray)
        + validate() -> bool
        + clone() -> FixedTopologyGenome
        + to_dict() -> dict
        + {static} from_dict(data: dict) -> FixedTopologyGenome
        + mutate(mutation_rate: float, mutation_std: float)
    }
}

package "deap_pettingzoo.policies" {
    class FeedforwardNeuralPolicy {
        - genome: FixedTopologyGenome
        - layers: List[np.ndarray]
        - biases: List[np.ndarray]
        - activation_fn: callable
        - head: Optional[ActionHead]
        --
        + __init__(genome, action_space=None, head=None)
        + get_action(observation, deterministic=True) -> action
        + reset() -> None
        + forward(x: np.ndarray) -> np.ndarray
    }

    abstract class ActionHead {
        + {abstract} decode(raw_output) -> Any
        + {abstract} output_size: int
    }

    class DiscreteHead {
        + n: int
        + decode(raw) -> int  (argmax)
    }

    class MaskedDiscreteHead {
        + n: int
        + decode(raw, action_mask=None) -> int
        -- mask illegal logits to -inf before argmax --
    }

    class BoxHead {
        + low, high: np.ndarray
        + decode(raw) -> np.ndarray  (tanh → rescale)
    }

    class "make_head(space, masked=False)" as make_head <<factory>>
    class "required_output_size(space)" as required_output_size <<helper>>

    DiscreteHead --|> ActionHead
    MaskedDiscreteHead --|> DiscreteHead
    BoxHead --|> ActionHead
    make_head ..> ActionHead : constructs
    FeedforwardNeuralPolicy --> FixedTopologyGenome : uses
    FeedforwardNeuralPolicy --> ActionHead : optional head
}

package "deap_pettingzoo.contrib.pursuit_evasion (APF)" {
    class APFConfig <<dataclass>> {
        + k_pursuer: float
        + k_landmark: float
        + k_boundary: float
        + boundary_threshold: float
        + no_op_threshold: float
        + softening: float
    }

    class APFEvaderPolicy {
        - config: APFConfig
        - layout: ObsLayout
        --
        + __init__(layout, config=None)
        + get_action(observation) -> action
        + reset() -> None
    }

    APFEvaderPolicy --> APFConfig : uses
}

package "deap_pettingzoo.environments" {
    class PettingZooWrapper {
        - env
        + env_name: str
        + env_spec: EnvSpec
        + default_episode_len: int
        + agents: List[str]
        + num_agents: int
        --
        + __init__(env_name, env_config=None, render_mode=None)
        + reset(seed, options) -> observations
        + step(actions) -> tuple
        + observation_space(agent: str) -> Space
        + action_space(agent: str) -> Space
        + render() -> np.ndarray
        + close() -> None
        + {static} supported_envs() -> List[str]
    }

    class EnvSpec <<dataclass>> {
        + name: str
        + factory: Any
        + default_episode_len: int
        + continuous_default: bool
        + notes: str
        + tags: frozenset
        + api: EnvApi
        + wrappers: Tuple[Callable, ...]
        -- api \u2208 {parallel, aec, auto,\n     aec_masked, aec_sequential} --
    }

    class registry <<module>> {
        + {static} register_env(name, factory, *, api="parallel", wrappers=(), **meta) -> EnvSpec
        + {static} unregister_env(name): None
        + {static} get_env_spec(name) -> EnvSpec
        + {static} is_registered(name) -> bool
        + {static} list_envs(tag=None, api=None) -> List[str]
        + {static} build_env(name, env_config, render_mode)
        -- build_env applies wrappers\n   left-to-right after api coercion --
    }

    class builtin <<module>> {
        auto-registers MPE2 envs\n+ aquarium_v0 (if installed)
    }

    abstract class TurnBasedAdapter {
        + possible_agents: List[str]
        + metadata: dict
        + reset(seed) -> observations
        + step(actions) -> tuple
    }

    class MaskedSimultaneousAdapter {
        parallel-shaped facade over AEC;\nevery active agent appears each step;\nonly current player's action executes;\ninfos[agent]["action_mask"] threaded.
    }

    class SequentialTurnAdapter {
        single-agent-per-step dicts;\npreserves true turn semantics.
    }

    TurnBasedAdapter <|-- MaskedSimultaneousAdapter
    TurnBasedAdapter <|-- SequentialTurnAdapter

    PettingZooWrapper ..> registry : resolves env_name
    registry "1" *-- "*" EnvSpec
    builtin ..> registry : register_env
    registry ..> TurnBasedAdapter : wraps on\napi=aec_masked\n/ aec_sequential
}

package "deap_pettingzoo.contrib.openspiel" {
    class openspiel <<module>> {
        + {static} register_openspiel_game(name, *, game_name, api="aec_masked",\n         default_episode_len=50, wrappers=(), **reg_kwargs) -> EnvSpec
        -- thin Shimmy bridge to OpenSpiel\n   turn-based board / card games --
    }

    openspiel ..> registry : register_env
}

package "deap_pettingzoo.contrib.pursuit_evasion" {
    class PursuitEvasionConfig <<dataclass>> {
        + num_adversaries: int
        + num_good: int
        + num_obstacles: int
        + max_cycles: int
        + equal_ability: bool
        + equal_max_speed: float
        + equal_accel: float
        + num_agent_neighbors: Optional[int]
        + num_landmark_neighbors: Optional[int]
        + boundary_threshold: float
        -- requires homogeneous obs sizes;\n   raises ValueError otherwise\n   (use SuperSuit padding or\n   MixedPolicyEvaluator) --
    }

    class SelfPlayEvaluator {
        - env_wrapper: PettingZooWrapper
        - max_steps: int
        - aggregation: str
        - team_mapping: Dict[str, str]
        - team: Optional[str]
        - masked: bool
        - flatten_obs: bool
        --
        + __init__(env_wrapper, max_steps, aggregation, team_mapping, team, masked, flatten_obs)
        + evaluate(individual, seed=None) -> Tuple[float]
        -- one shared-weights policy plays\n   every role in a turn-based env;\n   aggregation ∈ {sum, mean,\n     first_agent, team_mapping} --
        + boundary_scale: float
        + boundary_sharpness: float
    }

    class ObsLayout <<dataclass>> {
        + describes observation vector slicing
    }

    class PursuitEvasionEnv {
        + config: PursuitEvasionConfig
        + obs_layout: ObsLayout
        --
        + __init__(config=None, **kwargs)
        + reset(seed) -> observations
        + step(actions) -> tuple
    }

    PursuitEvasionEnv --|> PettingZooWrapper
    PursuitEvasionEnv --> PursuitEvasionConfig : uses
    PursuitEvasionEnv --> ObsLayout : uses
}

package "deap_pettingzoo.evaluators" {
    abstract class BaseEvaluator {
        + {abstract} evaluate(individual) -> fitness
    }

    class SingleEpisodeEvaluator {
        - env_wrapper: PettingZooWrapper
        - max_steps: int
    BaseEvaluator <|-- SelfPlayEvaluator
    MultiEpisodeEvaluator --> SingleEpisodeEvaluator : delegates
    SingleEpisodeEvaluator --> PettingZooWrapper : uses
    SingleEpisodeEvaluator ..> FeedforwardNeuralPolicy : creates
    SelfPlayEvaluator --> PettingZooWrapper : uses
    SelfPlayEvaluator ..> FeedforwardNeuralPolicy : creates (masked head)
        + __init__(env_wrapper, max_steps, aggregation_method, team_mapping)
        + evaluate(individual, seed=None) -> Tuple[float]
        - _create_policies(genome, observations) -> dict
        - _aggregate_fitness(rewards: dict) -> float
        - _aggregate_team_fitness(rewards: dict) -> float
        -- requires homogeneous obs sizes;\n   raises ValueError otherwise\n   (use SuperSuit padding or\n   MixedPolicyEvaluator) --
    }

    class SelfPlayEvaluator {
        - env_wrapper: PettingZooWrapper
        - max_steps: int
        - aggregation: str
        - team_mapping: Dict[str, str]
        - team: Optional[str]
        - masked: bool
        - flatten_obs: bool
        --
        + __init__(env_wrapper, max_steps, aggregation, team_mapping, team, masked, flatten_obs)
        + evaluate(individual, seed=None) -> Tuple[float]
        -- one shared-weights policy plays\n   every role in a turn-based env;\n   aggregation ∈ {sum, mean,\n     first_agent, team_mapping} --
    }

    class MultiEpisodeEvaluator {
        - single_evaluator: SingleEpisodeEvaluator
        - num_episodes: int
        - aggregation: str
        - base_seed: int
        --
        + __init__(env_wrapper, genome_config, num_episodes, aggregation, base_seed, ...)
        + evaluate(individual) -> tuple
        + evaluate_with_stats(individual) -> tuple[mean, std, min, max]
    }

    class MixedPolicyEvalResult <<dataclass>> {
        + rewards: dict
        + episode_length: int
        + captured: bool
    }

    class MixedPolicyEvaluator {
        - env_wrapper: PettingZooWrapper
        - max_steps: int
        --
        + __init__(env_wrapper, max_steps, ...)
        + evaluate(policies: dict, seed=None) -> MixedPolicyEvalResult
    }

    BaseEvaluator <|-- SingleEpisodeEvaluator
    BaseEvaluator <|-- MultiEpisodeEvaluator
    BaseEvaluator <|-- MixedPolicyEvaluator
    BaseEvaluator <|-- SelfPlayEvaluator
    MultiEpisodeEvaluator --> SingleEpisodeEvaluator : delegates
    SingleEpisodeEvaluator --> PettingZooWrapper : uses
    SingleEpisodeEvaluator ..> FeedforwardNeuralPolicy : creates
    SelfPlayEvaluator --> PettingZooWrapper : uses
    SelfPlayEvaluator ..> FeedforwardNeuralPolicy : creates (masked head)
    MixedPolicyEvaluator ..> MixedPolicyEvalResult : returns
}

package "deap_pettingzoo.integration" {
    class "deap_integration (module)" as deap_integration_mod <<module>> {
        + setup_deap_creators() -> None
        + create_deap_individual(genome_config) -> Individual
        + evaluate_individual(individual, evaluator) -> tuple
        + create_toolbox(genome_config, evaluator, **kwargs) -> Toolbox
        + crossover_blend(ind1, ind2, alpha) -> tuple
        + mutate_gaussian(individual, mu, sigma, indpb) -> tuple
        + clone_individual(individual) -> Individual
    }

    class "cma_integration (module)" as cma_integration_mod <<module>> {
        + setup_cma_strategy(genome_config, sigma0, population_size, centroid) -> (Strategy, dim)
        + make_cma_ind_init(genome_config) -> callable
        + register_cma_toolbox(strategy, ind_init, evaluator) -> Toolbox
        + make_cma_stats() -> tools.Statistics
        - _setup_cma_creators() -> None
    }

    deap_integration_mod ..> FixedTopologyGenome : wraps
    cma_integration_mod ..> FixedTopologyGenome : wraps
}

package "deap_pettingzoo.baselines" {
    enum BudgetMode {
        ENV_STEPS
        EVAL_EPISODES
        WALL_CLOCK
    }

    interface PolicyProtocol <<Protocol>> {
        + get_action(observation) -> action
        + reset() -> None
    }

    class TrainingConfig <<dataclass>> {
        + env_name: str
        + budget_mode: BudgetMode
        + budget_value: int
        + num_seeds: int
        + algorithm_params: dict
        + output_dir: Path
        + render: bool
    }

    class TrainingResult <<dataclass>> {
        + algorithm: str
        + policy: PolicyProtocol
        + metrics: dict
        + metadata: dict
        + seed: int
        + training_time: float
    }

    class EvalResult <<dataclass>> {
        + mean_reward: float
        + std_reward: float
        + min_reward: float
        + max_reward: float
        + num_episodes: int
        + episode_rewards: List[float]
        + episode_lengths: List[int]
        + to_dict() -> dict
    }

    class ComparisonConfig <<dataclass>> {
        + algorithms: List[str]
        + env_name: str
        + budget_mode: BudgetMode
        + budget_value: int
        + num_seeds: int
        + eval_episodes: int
        + algorithm_configs: dict
        + output_dir: Path
    }

    abstract class BaselineTrainer {
        + {abstract} train(config: TrainingConfig) -> TrainingResult
        + {abstract} supports_budget_mode(mode: BudgetMode) -> bool
        + {abstract} get_capabilities() -> dict
    }

    abstract class BaselineEvaluator {
        + {abstract} evaluate(policy, env_name, num_episodes, seed, render) -> EvalResult
    }

    class GenomePolicyWrapper {
        - genome: FixedTopologyGenome
        - env_name: str
        - _policies: dict
        --
        + __init__(genome, env_name)
        + get_action(observation) -> action
        + reset() -> None
        + genome() -> FixedTopologyGenome
    }

    class EATrainer {
        - hidden_size: int
        - population_size: int
        - mutation_rate: float
        - crossover_rate: float
        - strategy: str  ' simple | mu_plus_lambda | mu_comma_lambda
        - mu: int
        - lambda_: int
        - selection_method: str
        - crossover_method: str
        - mutation_method: str
        --
        + __init__(hidden_size, population_size, ..., strategy, mu, lambda_, selection_method, crossover_method, mutation_method, selection_params, crossover_params, mutation_params)
        + train(config) -> TrainingResult
        + supports_budget_mode(mode) -> bool
        + get_capabilities() -> dict
        - _run_simple(...) -> None
        - _translate_budget(config) -> dict
    }

    class CMAESTrainer {
        - hidden_size: int
        - population_size: int
        - sigma0: float
        - activation: str
        - variant: str  ' mu_mu_lambda | one_plus_lambda
        --
        + __init__(hidden_size, population_size, sigma0, activation, weight_range, variant)
        + train(config) -> TrainingResult
        + supports_budget_mode(mode) -> bool
        + get_capabilities() -> dict
        - _build_strategy(genome_config) -> (Strategy, int)
        - _translate_budget(config) -> dict
    }

    abstract class AgileRLTrainer {
        # ALGORITHM_NAME: str
        # ALGORITHM_IMPORT: tuple[str, str]
        # ON_POLICY: bool
        # DEFAULT_PARAMS: dict
        --
        + train(config) -> TrainingResult
        + supports_budget_mode(mode) -> bool
        + {abstract} get_capabilities() -> dict
        # _import_algorithm() -> type
        # _build_agent(obs_spaces, act_spaces, agent_ids, kwargs)
        # _run_off_policy(env, agent, ...) -> dict
        # _run_on_policy(env, agent, ...) -> dict
    }

    class MADDPGTrainer {
        # ALGORITHM_NAME = "maddpg"
        # ON_POLICY = False
    }
    class MATD3Trainer {
        # ALGORITHM_NAME = "matd3"
        # ON_POLICY = False
    }
    class IPPOTrainer {
        # ALGORITHM_NAME = "ippo"
        # ON_POLICY = True
    }
    class MAPPOTrainer {
        # ALGORITHM_NAME = "mappo"
        # ON_POLICY = True
    }
    class GroupedIPPOTrainer {
        # ALGORITHM_NAME = "ippo-grouped"
        # ON_POLICY = True
        --
        + {static} _group_prefix(agent_id) -> str
        + {static} _validate_grouping(agent_ids, obs, act) -> dict
    }

    class AgileRLPolicyWrapper {
        - _agent: agilerl.EvolvableAlgorithm
        - _agent_ids: list[str]
        - _call_index: int
        --
        + get_action(obs) -> Any
        + reset() -> None
    }

    class UnifiedEvaluator {
        - max_steps: int
        - env_cache: dict
        --
        + __init__(max_steps)
        + evaluate(policy, env_name, num_episodes, seed, render) -> EvalResult
        - _run_episode(policy, env, seed) -> tuple
        + close()
    }

    class "comparison (module)" as comparison_mod <<module>> {
        - _TRAINER_REGISTRY: dict[str, type]
        --
        + register_trainer(name, trainer_class) -> None
        + get_trainer(name, **kwargs) -> BaselineTrainer
        + compare_baselines(config: ComparisonConfig) -> dict
        - _register_builtins() -> None
    }

    ' Relationships
    TrainingConfig --> BudgetMode : uses
    ComparisonConfig --> BudgetMode : uses
    TrainingResult --> PolicyProtocol : contains

    BaselineTrainer <|-- EATrainer
    BaselineTrainer <|-- CMAESTrainer
    BaselineTrainer <|-- AgileRLTrainer
    AgileRLTrainer <|-- MADDPGTrainer
    AgileRLTrainer <|-- MATD3Trainer
    AgileRLTrainer <|-- IPPOTrainer
    IPPOTrainer <|-- MAPPOTrainer
    IPPOTrainer <|-- GroupedIPPOTrainer
    BaselineEvaluator <|-- UnifiedEvaluator

    EATrainer ..> deap_integration_mod : uses
    EATrainer ..> GenomePolicyWrapper : produces
    CMAESTrainer ..> cma_integration_mod : uses
    CMAESTrainer ..> GenomePolicyWrapper : produces
    GenomePolicyWrapper --> FixedTopologyGenome : wraps
    GenomePolicyWrapper ..|> PolicyProtocol : implements

    AgileRLTrainer --> AgileRLPolicyWrapper : produces
    AgileRLPolicyWrapper ..|> PolicyProtocol : implements

    comparison_mod ..> BaselineTrainer : registry
    comparison_mod --> UnifiedEvaluator : uses
    comparison_mod --> ComparisonConfig : consumes

    FeedforwardNeuralPolicy ..|> PolicyProtocol : implements
    APFEvaderPolicy ..|> PolicyProtocol : implements
}

' Cross-package interaction notes
SingleEpisodeEvaluator ..> FixedTopologyGenome : evaluates
MixedPolicyEvaluator ..> PolicyProtocol : runs

note bottom of FixedTopologyGenome
  Genome is a flat vector of weights
  for a fixed MLP architecture.
end note

note bottom of CMAESTrainer
  Wraps deap.cma.Strategy. Uses a
  custom CMAIndividual (list subclass
  with a .genome attribute) so that
  numpy.array(pop) inside strategy.update
  works while preserving evaluator
  contract.
end note

note bottom of GenomePolicyWrapper
  Shared adapter used by both EATrainer
  and CMAESTrainer to expose a trained
  genome as a PolicyProtocol for
  UnifiedEvaluator.
end note

note bottom of MixedPolicyEvaluator
  Evaluates heterogeneous per-agent
  policies (e.g. EA pursuers vs. APF
  evaders) in one episode.
end note

note bottom of SelfPlayEvaluator
  Canonical EA evaluator for
  strictly turn-based AEC games
  (api='aec_masked' / 'aec_sequential').
  Installs a MaskedDiscreteHead so
  infos[agent]["action_mask"] is honoured.
end note

note bottom of registry
  EnvSpec.wrappers is an ordered chain
  of plain (env -> env) callables applied
  after api coercion. Typical use is
  composing supersuit transforms
  (pad_observations_v0, pad_action_space_v0,
  agent_indicator_v0, ...).
end note

note bottom of openspiel
  Opt-in; nothing registered on import.
  Requires `pip install deap-pettingzoo[shimmy]`.
  Wraps shimmy.OpenSpielCompatibilityV0
  for OpenSpiel turn-based games.
end note

package "deap_pettingzoo.baselines.coevolution" {

  interface "OpponentPool <<Protocol>>" as OpponentPool {
    +sample_opponent(rng): PolicyProtocol
    +sample_opponents(rng, k): List[PolicyProtocol]
    +update(population_like)
    +__len__(): int
  }

  class PopulationPool {
    -items: Sequence
    -factory: Callable
    -sampler: Sampler
    +sample_opponent(rng)
    +update(new_population)
  }

  class ArchivePool {
    -archive: HallOfFame
    -policy_factory: Callable
    -sampler: Sampler
    +sample_opponent(rng)
    +update(hof)
  }

  class FrozenPolicyPool {
    -policies: Sequence[PolicyProtocol]
    +sample_opponent(rng)
    +update(new_policies)
  }

  class CompositePool {
    -pools: Sequence[OpponentPool]
    -weights: Sequence[float]
    +__init__(pools, weights)
    +sample_opponent(rng)
  }

  abstract class HallOfFame {
    +items: List
    +fitnesses: ndarray
    +is_empty: bool
    +{abstract} add(snapshot, fitness)
    +extend(snapshots, fitnesses)
    +clear()
  }

  class RingHallOfFame {
    -capacity: int
    +add(snapshot, fitness)
  }

  class ElitistHallOfFame {
    -capacity: int
    +add(snapshot, fitness)
  }

  class "Side <<dataclass>>" as Side {
    +name: str
    +role_prefixes: Tuple[str, ...]
    +optimizer: str
    +optimizer_config: dict
    +hof: Optional[HallOfFame]
    +use_archive_in_opponent_pool: bool
    +archive_mix: float
    +opponent_sampler: Sampler
    +archive_sampler: Sampler
    +frozen_policies: Optional[Sequence]
  }

  abstract class SideState {
    +side: Side
    +{abstract} initialise(env, evaluator, rng)
    +{abstract} step_generation(evaluator, rng)
    +{abstract} current_pool(): OpponentPool
    +{abstract} best_policy(): PolicyProtocol
    +snapshot_best()
  }

  class EASideState
  class CMAESSideState
  class FrozenSideState

  class "CoEvolutionConfig <<dataclass>>" as CoEvolutionConfig {
    +mode: str
    +sides: List[Side]
    +schedule: str
    +alternating_generations: int
    +k_opponents: int
    +aggregation: str
    +snapshot_every: int
    +reporting_side: Optional[str]
    +max_steps_per_episode: int
    +seed: Optional[int]
  }

  class CoEvolutionEvaluator {
    -env_wrapper: PettingZooWrapper
    -learner_role_prefixes: Tuple[str, ...]
    -learner_factory: Callable
    -opponent_sides: List[(name, prefixes, pool)]
    -k_opponents: int
    -aggregation: str
    -max_steps: int
    +__init__(env_wrapper, learner_role_prefixes, learner_factory,\n  opponent_sides, k_opponents, aggregation,\n  max_steps, flatten_obs, masked)
    +evaluate(individual, seed, rng)
  }

  class CoEvolutionTrainer {
    +train(config): TrainingResult
  }

  PopulationPool ..|> OpponentPool
  ArchivePool ..|> OpponentPool
  FrozenPolicyPool ..|> OpponentPool
  CompositePool ..|> OpponentPool

  HallOfFame <|-- RingHallOfFame
  HallOfFame <|-- ElitistHallOfFame

  SideState <|-- EASideState
  SideState <|-- CMAESSideState
  SideState <|-- FrozenSideState

  SideState o-- Side
  Side o-- HallOfFame

  ArchivePool --> HallOfFame : "reads"
  CompositePool o-- "*" OpponentPool

  CoEvolutionConfig *-- "1..*" Side
  CoEvolutionTrainer ..> CoEvolutionConfig : consumes
  CoEvolutionTrainer ..> SideState : "builds per side"
  CoEvolutionTrainer ..> CoEvolutionEvaluator : uses
  CoEvolutionEvaluator ..> OpponentPool : "samples one per side"
}

note bottom of OpponentPool
  Source-agnostic Protocol. Any object
  satisfying this contract (population,
  archive, frozen RL policies, future
  QDax repertoires) plugs into
  CoEvolutionTrainer without trainer
  modification.
end note

note bottom of CoEvolutionTrainer
  Registered as "coevolution". Three modes:
  competitive_2pop, self_play_hof, cooperative.
  Schedule: synchronous | alternating.
  Reports reporting_side's best policy.
end note

@enduml
