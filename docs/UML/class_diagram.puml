        + algorithms: list[str]
        + hyperparameters: dict
        + budget: BudgetSpecModel
        + fitness: FitnessSettingsModel
        + recording: RecordingSettingsModel
        + coevolution: CoevolutionSettingsModel | None
        + parallelism: ParallelismSettingsModel
        + raw_config: str | None
        + num_seeds: int
        + label: str
        --
        + to_dataclass() -> ExperimentSpec
    }

    class SubmitResponse <<pydantic>> {
        + id: str
        + status: str
        + position: int
    }

    class ExperimentRecord <<pydantic>> {
        + id: str
        + label: str
        + status: str
        + created_at: float
        + started_at: float | None
        + finished_at: float | None
        + run_dirs: list[str] | None
        + error: str | None
        + origin: str = "ui"
    }

    class ProgressSnapshot <<pydantic>> {
        + run_index: int
        + total_runs: int
        + algo: str
        + seed: int
        + unit: str
        + current: int
        + total: int
        + best_fitness: float | None
        + mean_fitness: float | None
        + wall_time_s: float
    }

    class Dispatcher {
        - _running: Task | None
        - _paused: bool
        - _worker_limit: int = 1
        --
        + start()
        + cancel(experiment_id)
        + shutdown()
    }

    class Runner <<subprocess>> {
        + run_experiment(spec_file, experiment_dir) -> int
        + ProgressWriter (callback -> _progress.json)
    }

    class FastAPIApp <<FastAPI>> {
        + GET /health
        + GET /catalog
        + POST /experiments
        + POST /experiments/validate
        + GET /experiments/{id}
        + GET /experiments/{id}/progress
        + GET /experiments/{id}/stdout
        + GET /experiments/{id}/export
        + GET /experiments/{id}/spec
        + DELETE /experiments/{id}
        + POST /experiments/{id}/cancel
        + POST /experiments/import
        + GET /runs/export
        + GET /queue
        + POST /queue/pause
        + POST /queue/resume
    }

    class db <<module>> {
        + create_tables()
        + insert_experiment(spec)
        + list_experiments(status, limit, offset)
        + dequeue_next() -> experiment | None
        + set_running / set_completed / set_failed / set_cancelled
        + update_progress(id, progress_json)
        + get_queue_state()
    }

    class export_import <<module>> {
        + build_export_manifest() -> dict
        + create_run_export_zip(run_dir, flags) -> bytes
        + create_experiment_export_zip_generator(...) -> Generator
        + validate_import_zip(zip, root) -> ImportValidationResult
        + extract_import_zip(zip, root) -> list
        + restore_experiment_to_db(json, dirs, db) -> str
    }
}

package "deap_pettingzoo.ui (components v0.2+)" #F5FFF5 {
    class ApiClient {
        - _client: httpx.Client
        - _base_url: str
        --
        + get_catalog() -> dict
        + get_algorithms() -> list
        + get_environment(name) -> dict
        + get_compatibility(env, algos) -> dict
        + validate(spec) -> ValidationReportModel
        + submit(spec) -> SubmitResponse
        + list_experiments() -> list[ExperimentRecord]
        + get_experiment(id) -> ExperimentRecord
        + get_progress(id) -> ProgressSnapshot
        + get_stdout(id, offset, limit) -> dict
        + get_experiment_spec(id) -> dict
        + build_experiment_export_url(id, flags) -> str
        + build_run_export_url(dirs, flags) -> str
        + import_experiments(zip, overwrite) -> dict
        + get_queue() -> QueueState
        + pause_queue() / resume_queue()
        + cancel_experiment(id) / delete_experiment(id)
    }

    class param_widgets <<module>> {
        + coerce_param(value, spec) -> Any
        + render_param(spec, key) -> value  (thin Streamlit wrapper)
    }

    class forms <<module>> {
        + build_env_form(catalog) -> (values, touched)
        + build_algo_form(catalog, env) -> (values, touched)
        + build_fitness_form(env_spec) -> (values, touched)
    }

    class validation_view <<module>> {
        + group_issues_by_tab(report) -> dict
        + render_validation_report(report)
    }

    class spec_utils <<module>> {
        + spec_to_form_defaults(spec) -> dict
        + extract_loaded_spec(setup_config) -> dict | None
    }
}

' Cross-package relationships (v0.2+)
Catalog --> AlgorithmSpec : contains
Catalog --> EnvironmentSpec : contains
ExperimentSpecModel ..> ExperimentSpec : to_dataclass()
FastAPIApp --> Catalog : serves as JSON
FastAPIApp --> Dispatcher : lifespan manages
FastAPIApp --> db : async I/O
Dispatcher --> Runner : Popen subprocess
Runner --> "baselines.Trainer" : train(progress_callback)
ApiClient --> FastAPIApp : HTTP (FASTAPI_URL)
"Setup Page" ..> ApiClient : uses
"Queue Page" ..> ApiClient : uses
"Browse Page" ..> ApiClient : uses (export/import/re-run)
"Setup Page" ..> spec_utils : uses (re-run pre-populate)
AlgorithmSpec --> ParamSpec : hyperparameters
EnvironmentSpec --> TeamSpec : teams

policies ..> RunRecord : "reads .manifest"
policies ..> PolicyCheckpointEntry : parses
checkpoints ..> RunManifest : "writes .artifacts['policy']"
data ..> RunRecord : loads
data ..> Experiment : builds
config ..> UISettings : returns
_launcher ..> config : "DEAP_RESULTS_ROOT env"

@enduml
