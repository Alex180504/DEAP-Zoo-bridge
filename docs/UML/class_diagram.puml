package "deap_pettingzoo.contrib.qdax" {
    class FlaxPolicyAdapter {
        - module
        - params
        - masked: bool
        + get_action(obs, action_mask=None) -> Any
    }

    class "descriptors <<module>>" as qdax_descriptors {
        + formation_spread_and_mean_distance(num_pursuers, num_evaders)
        + with_capture_efficiency(num_pursuers, num_evaders, capture_radius)
        -- each returns a callable with\n   output_shape / min_bd / max_bd --
    }

    class "scoring <<module>>" as qdax_scoring {
        + make_jax_scoring_function(jax_env, module, *, episode_length,\n         descriptor_fn, action_type, agents=None,\n         extract_state_fn=None) -> Callable
        + make_numpy_scoring_function(env_name, *, layer_sizes,\n         episode_length, descriptor_fn, env_config=None,\n         action_type="discrete", activation="tanh",\n         num_workers=1, parallel_backend="process") -> Callable
        -- both return QDax contract:\n   (genotypes, key) -> (fitness, descriptor, extra_scores) --
    }

    class MAPElitesTrainer {
        + algorithm = "map_elites"
        + train(config): TrainingResult
        -- dispatches to jax scoring\n   when env.api == "jax_parallel",\n   numpy fallback otherwise --
    }

    class CMAMETrainer {
        + algorithm = "cma_me"
        + train(config): TrainingResult
        -- CMAImprovementEmitter +\n   CMAPoolEmitter over a\n   euclidean/CVT centroid grid --
    }

    FlaxPolicyAdapter ..|> PolicyProtocol : implements
    MAPElitesTrainer --|> BaselineTrainer
    CMAMETrainer     --|> BaselineTrainer
    MAPElitesTrainer ..> qdax_scoring : uses
    CMAMETrainer     ..> qdax_scoring : uses
    MAPElitesTrainer ..> qdax_descriptors : resolves by name
    CMAMETrainer     ..> qdax_descriptors : resolves by name
    MAPElitesTrainer ..> FlaxPolicyAdapter : produces best
    CMAMETrainer     ..> FlaxPolicyAdapter : produces best
}

