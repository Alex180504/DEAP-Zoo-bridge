@startuml sequence_maddpg_training
!theme plain

title MADDPG Training Workflow (Hybrid External Process + Embedded Wrapper)

participant "MADDPGTrainer" as Trainer
participant "subprocess" as Process
participant "CleanMARL\n(External)" as CleanMARL
participant "TensorBoard\nLogs" as TB
participant "Checkpoint\nLoader" as Loader
participant "PolicyWrapper" as Wrapper

activate Trainer

Trainer -> Trainer: _build_cleanmarl_cmd(config)
note right
  python -m cleanmarl.train \\
    --env_type=pz \\
    --env_family=mpe \\
    --env_name=simple_spread \\
    --algo=maddpg \\
    --total_timesteps=100000 \\
    --seed=42
end note

Trainer -> Process: subprocess.Popen(cmd)
activate Process

Process -> CleanMARL: launch training
activate CleanMARL

== Parallel Monitoring ==

par Training Process
    CleanMARL -> CleanMARL: initialize env
    CleanMARL -> CleanMARL: initialize MADDPG networks
    
    loop until budget exhausted
        CleanMARL -> CleanMARL: collect_experience()
        CleanMARL -> CleanMARL: update_networks()
        
        alt eval_freq reached
            CleanMARL -> TB: write eval metrics
            activate TB
            TB --> CleanMARL: logged
            deactivate TB
            
            CleanMARL -> CleanMARL: save_checkpoint()
            note right: Save actor/critic\nnetwork states
        end
    end
    
    CleanMARL -> TB: write final metrics
    CleanMARL --> Process: exit(0)
    deactivate CleanMARL

else Real-time Monitoring
    loop while process running
        Trainer -> TB: read_latest_metrics()
        activate TB
        TB --> Trainer: eval/ep_reward, std, length
        deactivate TB
        
        Trainer -> Trainer: update_training_metrics()
        
        alt timeout exceeded
            Trainer -> Process: terminate()
            note right: Graceful shutdown\nfor wall-clock budget
        end
        
        Trainer -> Trainer: sleep(polling_interval)
    end
end

Process --> Trainer: return_code
deactivate Process

alt return_code != 0
    Trainer -> Trainer: raise TrainingError()
else success
    Trainer -> Trainer: parse_final_metrics()
end

== Checkpoint Loading ==

Trainer -> Loader: load_checkpoint(best_checkpoint_path)
activate Loader

Loader -> Loader: torch.load(checkpoint)
note right: Load saved network\nstate dictionaries

Loader -> Wrapper: create MADDPGPolicy(actor_networks)
activate Wrapper

Wrapper -> Wrapper: initialize networks
Wrapper -> Wrapper: set eval mode
note right: Disable exploration\nfor deterministic evaluation

Wrapper --> Loader: policy
deactivate Wrapper

Loader --> Trainer: PolicyProtocol instance
deactivate Loader

Trainer -> Trainer: create TrainingResult()
note right
  TrainingResult contains:
  - policy: wrapped MADDPG actors
  - metrics: parsed from TB logs
  - metadata: cleanmarl config
  - training_time: wall clock
end note

Trainer --> Trainer: return TrainingResult
deactivate Trainer

note bottom of Wrapper
  PolicyWrapper implements PolicyProtocol:
  - get_action(obs) -> uses actor network
  - reset() -> no-op for feedforward
  
  Compatible with UnifiedEvaluator
end note

@enduml
