@startuml sequence_full_evolutionary_loop
!theme plain
title Sequence Diagram: Complete Evolutionary Loop Integration

actor "User/\nResearcher" as User
participant "Evolution\nRunner" as Runner
participant "DEAP\nToolbox" as Toolbox
participant "Parallel\nEvaluator" as ParallelEval
participant "Multi\nEpisodeEvaluator" as MultiEval
participant "Logger" as Log
participant "Checkpointer" as Checkpoint
participant "Visualizer" as Viz

== Setup Phase ==

User -> Runner : __init__(config)
activate Runner

Runner -> Toolbox : create_toolbox(config)
activate Toolbox

Toolbox -> Toolbox : register genome creator
Toolbox -> Toolbox : register individual creator
Toolbox -> Toolbox : register population creator
Toolbox -> Toolbox : register selection (tournament, roulette, etc.)
Toolbox -> Toolbox : register crossover operator
Toolbox -> Toolbox : register mutation operator

Toolbox -> ParallelEval : __init__(env_wrapper, config)
activate ParallelEval
ParallelEval -> MultiEval : create evaluators for workers
activate MultiEval
MultiEval --> ParallelEval : evaluator instances
deactivate MultiEval
ParallelEval --> Toolbox : parallel_evaluator
deactivate ParallelEval

Toolbox -> Toolbox : register evaluate function
Toolbox --> Runner : configured toolbox
deactivate Toolbox

Runner -> Log : __init__(log_dir)
activate Log
Log --> Runner : logger
deactivate Log

Runner -> Checkpoint : __init__(checkpoint_dir)
activate Checkpoint
Checkpoint --> Runner : checkpointer
deactivate Checkpoint

Runner -> Toolbox : population = toolbox.population(n=pop_size)
activate Toolbox
Toolbox -> Toolbox : create random individuals
Toolbox --> Runner : initial_population
deactivate Toolbox

Runner --> User : ready to evolve
deactivate Runner

== Evolution Phase ==

User -> Runner : run(num_generations)
activate Runner

Runner -> Runner : halloffame = HallOfFame(n=10)
Runner -> Runner : stats = Statistics()

loop for generation in range(num_generations)
    
    Runner -> Runner : === Generation #{generation} ===
    
    ' Parallel Evaluation
    Runner -> ParallelEval : evaluate_population(population)
    activate ParallelEval
    
    par for each individual in population (parallel)
        ParallelEval -> MultiEval : evaluate(individual)
        activate MultiEval
        
        MultiEval -> MultiEval : run multiple episodes
        note right
          As detailed in 
          multi-episode diagram
        end note
        
        MultiEval --> ParallelEval : (fitness,)
        deactivate MultiEval
    end
    
    ParallelEval --> Runner : fitnesses = [(f1,), (f2,), ...]
    deactivate ParallelEval
    
    ' Assign fitness to individuals
    Runner -> Runner : assign fitnesses to population
    loop for ind, fit in zip(population, fitnesses)
        Runner -> Runner : ind.fitness.values = fit
    end
    
    ' Update statistics
    Runner -> Runner : record = stats.compile(population)
    Runner -> Log : log_generation(generation, record)
    activate Log
    Log -> Log : append to stats list
    Log -> Log : write to CSV/JSON
    Log --> Runner : logged
    deactivate Log
    
    ' Update hall of fame
    Runner -> Runner : halloffame.update(population)
    
    ' Checkpointing
    alt generation % checkpoint_frequency == 0
        Runner -> Checkpoint : save(population, generation, stats)
        activate Checkpoint
        Checkpoint -> Checkpoint : pickle population and metadata
        Checkpoint --> Runner : checkpoint saved
        deactivate Checkpoint
    end
    
    ' Visualization
    alt generation % viz_frequency == 0
        Runner -> Viz : plot_fitness_evolution(stats)
        activate Viz
        Viz -> Viz : create matplotlib plot
        Viz --> Runner : plot saved
        deactivate Viz
    end
    
    ' Selection
    Runner -> Toolbox : offspring = toolbox.select(population, k)
    activate Toolbox
    Toolbox -> Toolbox : tournament/roulette selection
    Toolbox --> Runner : selected individuals
    deactivate Toolbox
    
    Runner -> Runner : offspring = [clone(ind) for ind in offspring]
    
    ' Crossover
    loop for child1, child2 in pairs(offspring)
        alt random() < crossover_prob
            Runner -> Toolbox : toolbox.mate(child1, child2)
            activate Toolbox
            Toolbox -> Toolbox : crossover genomes
            Toolbox -> Toolbox : del child1.fitness.values
            Toolbox -> Toolbox : del child2.fitness.values
            Toolbox --> Runner : modified children
            deactivate Toolbox
        end
    end
    
    ' Mutation
    loop for mutant in offspring
        alt random() < mutation_prob
            Runner -> Toolbox : toolbox.mutate(mutant)
            activate Toolbox
            Toolbox -> Toolbox : mutate genome weights
            Toolbox -> Toolbox : del mutant.fitness.values
            Toolbox --> Runner : modified mutant
            deactivate Toolbox
        end
    end
    
    ' Replace population
    Runner -> Runner : population = offspring
    
end

== Results Phase ==

Runner -> Runner : best_individual = halloffame[0]

Runner -> Log : save_final_results()
activate Log
Log -> Log : export all statistics
Log --> Runner : saved
deactivate Log

Runner -> Viz : plot_fitness_evolution(stats)
activate Viz
Viz --> Runner : final plots
deactivate Viz

Runner -> Viz : plot_diversity(final_population)
activate Viz
Viz --> Runner : diversity plot
deactivate Viz

Runner -> Checkpoint : save(population, num_generations, stats, "final")
activate Checkpoint
Checkpoint --> Runner : final checkpoint
deactivate Checkpoint

Runner --> User : evolution_results = {\n  'best_individual': best_individual,\n  'halloffame': halloffame,\n  'statistics': stats,\n  'final_population': population\n}
deactivate Runner

== Post-Analysis (Optional) ==

User -> Runner : get_best_individual()
activate Runner
Runner --> User : best_individual
deactivate Runner

User -> User : test best policy in environment
User -> User : compare with RL baselines
User -> User : statistical analysis
User -> User : publish results

note over User
  **Research Workflow:**
  1. Multiple independent runs
  2. Statistical significance testing
  3. Comparison with RL baselines
  4. Ablation studies
  5. Generalization testing
end note

@enduml
