@startuml sequence_analysis_pipeline
title Analysis Pipeline – Disk -> Experiment -> Stats / Plots / Report

actor "Researcher" as R
participant "load_experiment" as LE
participant "Experiment" as EX
participant "RunRecord" as RR
participant "aggregate" as AG
participant "compare" as CMP
participant "rliable_bridge" as RLB
participant "plots" as PL
participant "report.build_report" as RPT
database  "Filesystem\n<root>/<run_dir>/" as FS

R -> LE: load_experiment("results/exp1")
LE -> FS: glob "**/manifest.json"
loop per run dir
    LE -> RR: RunRecord(run_dir, manifest, metrics, episodes, summary)
    RR -> FS: read manifest.json + metrics.csv + summary.json
end
LE --> R: Experiment(root, runs)

R -> EX: filter(algorithm=...)
EX --> R: filtered Experiment

R -> EX: summary_table()
EX --> R: pd.DataFrame[algorithm, env, seed, run_id, wall_time_s,\n  final_fitness, eval_mean_reward, score_provenance]

R -> EX: final_scores(metric="final_fitness")
note right of EX: "final_fitness" resolves through RunRecord.comparison_score —\nprefers held-out eval_mean_reward, never silently substitutes a\ntraining reward (provenance via score_provenances(metric))
EX --> R: dict[algo -> ndarray]  (held-out-preferred)

R -> AG: aggregate_summary(score_groups)
note right of AG: warns (or raises if require_equal_n) on\nunequal per-algorithm n; n_seeds surfaced.\niqm() count-trims 25%/end (== rliable, tie-safe)
AG --> R: DataFrame[mean+CI, iqm+CI, median, n_seeds]

R -> AG: learning_curve_with_ci(runs, statistic="iqm")
note right of AG: y_col auto-detects best->mean->max so\nproduct-path runs (mean only) curve too
AG --> R: DataFrame[x, y, low, high]

R -> EX: per_agent_table()
EX -> RR: read .trajectories (per-agent reward rows)
EX --> R: DataFrame[algorithm, seed, agent, total_reward,\n  mean_episode_reward, n_steps]

R -> CMP: pairwise_table(experiment, test="mann_whitney")
CMP --> R: long-form DataFrame[a, b, p, cliffs_delta, cohens_d]

opt rliable installed
    R -> RLB: aggregate_metrics_table(score_groups)
    note right of RLB: optimality_gap omitted on the raw\nsingle-task path (meaningless un-normalised)
    RLB --> R: DataFrame
    R -> RLB: performance_profile(score_groups, taus)
    RLB --> R: DataFrame
end

R -> EX: export("campaign.csv", include_config=True)
EX -> FS: write per-(algo,env,seed) rows\n+ seed/budget/git_sha/hyperparams
EX --> R: Path

alt experiment spans >= 2 environments (multi-task)
    participant "multi_task" as MT
    participant "normalize" as NR
    R -> MT: collect_score_matrices(experiment)
    MT -> EX: by_env() / runs_for(algorithm, env)
    MT --> R: dict[algo -> ndarray(n_runs, n_envs)], env_names
    R -> NR: NormalizationSpec.from_minmax(matrices, env_names)
    NR --> R: NormalizationSpec
    R -> NR: normalize_score_matrices(matrices, env_names, spec)
    NR --> R: dict[algo -> normalised ndarray]
    R -> RLB: aggregate_metrics_forest(score_matrices)
    RLB --> R: DataFrame[algorithm, metric, point, lo, hi]
    R -> RLB: performance_profile(score_matrices=...)
    R -> RLB: probability_of_improvement(score_matrices=...)
    R -> PL: plot_aggregate_metrics_forest(forest)
    R -> PL: plot_normalized_performance_profile(...)
    R -> PL: plot_per_env_eval(matrices, env_names)
end

R -> PL: plot_learning_curves(runs_by_algo)
PL --> R: matplotlib Figure
R -> PL: plot_eval_distribution(score_groups)
PL --> R: Figure

R -> RPT: build_report(experiment, out_dir, fmt="html")
RPT -> AG: aggregate_summary(...)
RPT -> CMP: pairwise_table(...)
RPT -> PL: plot_eval_distribution(...)
RPT -> PL: plot_learning_curves(...)
RPT -> FS: write report.html + figures
RPT --> R: Path

@enduml
