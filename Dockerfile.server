# ===========================================================================
# Dockerfile.server — DEAP-bridge Experiment Service (FastAPI + trainers)
# ===========================================================================
#
# Build:
#   docker build -t deap-bridge-service -f Dockerfile.server .
#
# Run (standalone):
#   docker run -p 8100:8100 -v ./results:/app/results deap-bridge-service
#
# GPU / CUDA variant (for GPU-accelerated RL training):
#   The torch wheel index is a build arg, so no base-image change is needed.
#     docker build -f Dockerfile.server \
#       --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121 \
#       -t deap-bridge-service:cuda .
#     docker run --gpus all -p 8100:8100 -v ./results:/app/results deap-bridge-service:cuda
#   Or use the compose override: see docker-compose.gpu.yml
# ===========================================================================

FROM python:3.11-slim-bookworm

# --- System dependencies ---------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    # For potential C-extensions and OpenMP in numpy/scipy
    libgomp1 \
    # git: required for the Advanced install panel's `git clone` and for
    #   `pip install git+https://…` (the recommended way to install a custom
    #   environment package, e.g. a marl-aquarium fork).
    # build-essential: a C/C++ toolchain so custom env packages that ship only
    #   an sdist (and need to compile) can build inside the slim image.
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# --- Create non-root user --------------------------------------------------
RUN groupadd --system deap && \
    useradd --system --no-log-init --gid deap --create-home deap

# --- Application directory -------------------------------------------------
WORKDIR /app

# --- Install the package ---------------------------------------------------
# Copy only what pip needs first (layer caching for deps).
COPY pyproject.toml README.md LICENSE.txt ./
COPY deap_pettingzoo/ deap_pettingzoo/
# Ship the example experiment scripts so user-pasted scripts (Setup -> Advanced)
# that import `examples.pursuit_evasion.*` modules resolve. PYTHONPATH/
# DEAP_PROJECT_ROOT are set below so both `deap_pettingzoo` and `examples` import.
COPY examples/ examples/

# torch wheel index — CPU by default (lean, ~no GPU). Override at build time
# with a CUDA index (e.g. .../whl/cu121) to get a CUDA-enabled torch:
#   --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# Install torch first (CPU index avoids the ~2 GB CUDA wheel on the default
# build), then AgileRL without deps (it pins pettingzoo~=1.23.1 which conflicts
# with mpe2's >=1.24.3 — works fine at runtime though), then the rest.
#
# AgileRL is installed --no-deps *only* to keep mpe2's newer pettingzoo. That
# also drops AgileRL's other runtime deps (packaging, accelerate, tensordict,
# …), which makes `import agilerl` fail at runtime with
# `ModuleNotFoundError: No module named 'packaging'` and breaks every
# MADDPG/MATD3 experiment. So we explicitly reinstall AgileRL's runtime deps
# below, *excluding* pettingzoo (kept at mpe2's version) and the heavy bits
# torch-based MADDPG/MATD3 don't use (jax, minari, the pre-commit dev tool).
RUN pip install --no-cache-dir --index-url ${TORCH_INDEX_URL} \
    "torch>=2.0.0" && \
    pip install --no-cache-dir --no-deps "agilerl>=2.6,<3" && \
    pip install --no-cache-dir ".[service]" && \
    pip install --no-cache-dir \
        accelerate dill fastrand flatten-dict google-cloud-storage h5py \
        hydra-core matplotlib omegaconf packaging pandas pymunk redis \
        tensordict termcolor tqdm wandb

# --- Runtime setup ---------------------------------------------------------
# The results volume is mounted at /app/results at runtime (may be root-owned).
# Keep the SQLite DB in a non-volume directory so it's always writable.
RUN mkdir -p /app/results /app/data && chown deap:deap /app/results /app/data

ENV DEAP_RESULTS_ROOT=/app/results
ENV DEAP_SERVICE_DB=/app/data/_service.db

ENV DEAP_PROJECT_ROOT=/app
ENV PYTHONPATH=/app

# Advanced surface (dependency-install panel + custom-script submission) is
# enabled by default. Set DEAP_ENABLE_ADVANCED=0 to disable on shared/exposed
# deployments. NOTE: pip installs done via the panel live in this container's
# site-packages and are LOST on rebuild — add permanent deps to this Dockerfile.
ENV DEAP_ENABLE_ADVANCED=1

# --- Diagnostic logging ----------------------------------------------------
# Default "warning" logs only warnings + exceptions.  Override at run time
# (e.g. `-e DEAP_LOG_LEVEL=info`) to also log normal operation / which
# components are active.  Logs are emitted to stdout AND to a rotating file at
# $DEAP_RESULTS_ROOT/_logs/service.log (on the mounted results volume).
#
# Retrieve logs from the running container:
#   docker compose logs -f service                          # live stdout
#   docker exec deap-service cat /app/results/_logs/service.log
#   docker cp deap-service:/app/results/_logs ./logs        # copy out
#   curl 'http://127.0.0.1:8100/logs?lines=200'             # via the API
ENV DEAP_LOG_LEVEL=warning
ENV DEAP_LOG_FORMAT=plain

# Bind to 0.0.0.0 so docker-compose / container networks can reach the port.
# The host firewall / docker port mapping controls external access.
EXPOSE 8100

USER deap

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8100/health')" || exit 1

ENTRYPOINT ["python", "-m", "deap_pettingzoo.service", \
            "--host", "0.0.0.0", "--port", "8100"]
