# ===========================================================================
# Dockerfile.server — DEAP-bridge Experiment Service (FastAPI + trainers)
# ===========================================================================
#
# Build:
#   docker build -t deap-bridge-service -f Dockerfile.server .
#
# Run (standalone):
#   docker run -p 8100:8100 -v ./results:/app/results deap-bridge-service
#
# CUDA variant (for GPU-accelerated RL training):
#   1. Change the FROM line below to a CUDA base, e.g.:
#        FROM nvidia/cuda:12.1-runtime-ubuntu22.04
#      (and install Python 3.11 manually or use a CUDA-python hybrid).
#   2. Remove the --index-url flag from the torch install step so the
#      CUDA-enabled wheel is pulled from PyPI.
#   3. Add `--gpus all` to your docker run or compose file.
# ===========================================================================

FROM python:3.11-slim-bookworm

# --- System dependencies ---------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    # For potential C-extensions and OpenMP in numpy/scipy
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# --- Create non-root user --------------------------------------------------
RUN groupadd --system deap && \
    useradd --system --no-log-init --gid deap --create-home deap

# --- Application directory -------------------------------------------------
WORKDIR /app

# --- Install the package ---------------------------------------------------
# Copy only what pip needs first (layer caching for deps).
COPY pyproject.toml README.md LICENSE.txt ./
COPY deap_pettingzoo/ deap_pettingzoo/

# Install torch CPU-only first to avoid pulling the ~2 GB CUDA wheel,
# then AgileRL without deps (it pins pettingzoo~=1.23.1 which conflicts
# with mpe2's >=1.24.3 — works fine at runtime though), then the rest.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
    "torch>=2.0.0" && \
    pip install --no-cache-dir --no-deps "agilerl>=2.6,<3" && \
    pip install --no-cache-dir ".[service]"

# --- Runtime setup ---------------------------------------------------------
# The results volume is mounted at /app/results at runtime (may be root-owned).
# Keep the SQLite DB in a non-volume directory so it's always writable.
RUN mkdir -p /app/results /app/data && chown deap:deap /app/results /app/data

ENV DEAP_RESULTS_ROOT=/app/results
ENV DEAP_SERVICE_DB=/app/data/_service.db
# Bind to 0.0.0.0 so docker-compose / container networks can reach the port.
# The host firewall / docker port mapping controls external access.
EXPOSE 8100

USER deap

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8100/health')" || exit 1

ENTRYPOINT ["python", "-m", "deap_pettingzoo.service", \
            "--host", "0.0.0.0", "--port", "8100"]
